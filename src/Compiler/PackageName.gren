{-| Functions for working with package identifiers.

@docs PackageName, example

## Constructors

@docs fromString, jsonDecoder

## Conversions

@docs toString, toJson, toFileName

## Queries

@docs isCore

## Common package names

@docs core, browser, node

-}


import Json.Encode as Json
import Json.Decode as Decode exposing (Decoder)


{-| An example package identifier. Useful for tests.
-}
example : PackageName
example =
    PackageName "example.com/example/package"


{-| A package is identified by where it lives: a URL path, which is the host and
then the path to the package within its repository.

    github.com/geng-language/node
    gitlab.com/acme/tooling/argparse
    git.corp.example/team/pkg.git/sub

The one exception is `core`, which has no host because the toolchain distributes
it. (Geng's `packaging.md` K7.)

An identifier was an `author/name` pair, which is Gren's shape and says the
package is on GitHub. A package below its repository's root has as many parts as
its path does, so the identifier is one string.
-}
@derive(Eq)
type PackageName
    = PackageName String


{-| Attempt to convert a `String` into [PackageName](#PackageName).

It is `core`, or a host and one or more path elements. The host is lower case,
has a dot in it and neither begins nor ends with a dot or a hyphen. A path
element is ASCII letters, digits, `.`, `_` and `-`, is not empty and neither
begins nor ends with a dot, so `.` and `..` are not elements. There is no scheme
and no trailing slash.
-}
fromString : String -> Maybe PackageName
fromString str =
    if str == "core" then
        Just (PackageName str)

    else
        when String.split "/" str is
            [] ->
                Nothing

            [ _ ] ->
                Nothing

            segments ->
                when Array.popFirst segments is
                    Just { first = host, rest = path } ->
                        if isHost host && Array.all isElement path then
                            Just (PackageName str)

                        else
                            Nothing

                    Nothing ->
                        Nothing


isHost : String -> Bool
isHost host =
    String.contains "." host
        && String.all (\c -> Char.isLower c || Char.isDigit c || c == '.' || c == '-') host
        && not (String.contains ".." host)
        && notAtEitherEnd "." host
        && notAtEitherEnd "-" host


isElement : String -> Bool
isElement element =
    not (String.isEmpty element)
        && String.all (\c -> Char.isAlpha c || Char.isDigit c || c == '.' || c == '_' || c == '-') element
        && notAtEitherEnd "." element


notAtEitherEnd : String -> String -> Bool
notAtEitherEnd affix str =
    not (String.startsWith affix str) && not (String.endsWith affix str)


{-| A JSON decoder for [PackageName](#PackageName)
-}
jsonDecoder : Decoder PackageName
jsonDecoder =
    Decode.string
        |> Decode.andThen
            (\strValue ->
                when fromString strValue is
                    Just packageName ->
                        Decode.succeed packageName

                    Nothing ->
                        Decode.fail ("Not a valid package identifier: " ++ strValue)
            )


{-| Turn [PackageName](#PackageName) into a `String`.
-}
toString : PackageName -> String
toString (PackageName str) =
    str


{-| Turn [PackageName](#PackageName) into `Json`.
-}
toJson: PackageName -> Json.Value
toJson package =
    Json.string <| toString package


{-| The identifier as one file name, for a directory or a bundle named after the
package.

Each path element is escaped as Geng's generated names escape it (D296): `_` is
`_u`, `.` is `_d` and `-` is `_h`. The escaped elements are joined by `-`, which
none of them contains, so two identifiers never share a file name.
`github.com/geng-language/node` is `github_dcom-geng_hlanguage-node`, and an
escaped name has no `__` in it, which leaves that free to separate a version.
-}
toFileName : PackageName -> String
toFileName (PackageName str) =
    String.split "/" str
        |> Array.map
            (\segment ->
                segment
                    |> String.replace "_" "_u"
                    |> String.replace "." "_d"
                    |> String.replace "-" "_h"
            )
        |> String.join "-"


{-| Whether this is `core`, which every project has and no manifest lists.
-}
isCore : PackageName -> Bool
isCore package =
    package == core


{-| `core`
-}
core : PackageName
core =
    PackageName "core"


{-| `github.com/geng-language/browser`
-}
browser : PackageName
browser =
    PackageName "github.com/geng-language/browser"


{-| `github.com/geng-language/node`
-}
node : PackageName
node =
    PackageName "github.com/geng-language/node"
