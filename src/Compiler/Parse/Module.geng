module Compiler.Parse.Module exposing
    ( Error (..)
    , parser
    , errorToString
    , errorsToString
    )


{-| This will let you parse entire modules of Gren code.

@docs parser, Error, errorToString, errorsToString
-}


import String.Parser.Advanced as Parser exposing (Parser)
import Compiler.Ast.Source as AST
import Compiler.SourcePosition as SourcePosition
import Compiler.Parse.Space as Space
import Compiler.Parse.Variable as Variable
import Compiler.Parse.Operator as Operator
import Compiler.Parse.Declaration as Declaration
import Compiler.Parse.Number as Number
import Compiler.Parse.Declaration as Declaration exposing (Declaration)
import Compiler.Parse.Context exposing (Context)
import Compiler.ModuleName as ModuleName


{-| The kind of errors that can happen while parsing Gren modules.
-}
type Error
    = ExpectedKeyword String
    | ExpectedChar Char
    | VariableError Variable.Error
    | OperatorError Operator.Error
    | ExpectedIntPrecedence
    | DeclarationError Declaration.Error
    | SpaceError Space.Error
    | ExpectedEnd
    | InvalidModuleName String
    | RemovedModuleHeader String


{-| Returns a human-readable description of an `Error`.
-}
errorToString : Error -> String
errorToString error =
    when error is
        ExpectedKeyword keyword ->
            "Expected keyword '" ++ keyword ++ "'"
        
        ExpectedChar char ->
            "Expected character '" ++ String.fromChar char ++ "'"
        
        VariableError varError ->
            Variable.errorToString varError
        
        OperatorError opError ->
            Operator.errorToString opError
        
        ExpectedIntPrecedence ->
            "Expected integer precedence value"
        
        DeclarationError declError ->
            Declaration.errorToString declError
        
        SpaceError spaceError ->
            Space.errorToString spaceError

        ExpectedEnd ->
            "Expected end of file"

        InvalidModuleName name ->
            "Invalid module name '" ++ name ++ "': a module name is a capital letter followed by ASCII letters and digits, in each part"

        RemovedModuleHeader header ->
            "This module's header is `" ++ header ++ "`, and Geng has no such modules: a call into JavaScript is an `@extern` that answers a `Task`, and events the host produces arrive through a `Source`"


spaceParser : Parser Context Error {}
spaceParser =
    Parser.mapError SpaceError Space.parser


{-| Use this to parse an entire module (file) of Gren code.

    String.Parser.run parser Compiler.Parse.Context.empty source
-}
parser : Parser Context Error AST.Module
parser =
    Parser.succeed
        (\name exports docs imports binops decls ->
            let
                values =
                    Array.mapAndKeepJust declarationToModuleValue decls

                classes =
                    Array.mapAndKeepJust declarationToModuleClass decls

                instances =
                    Array.mapAndKeepJust declarationToModuleInstance decls

                unions =
                    Array.mapAndKeepJust declarationToModuleUnion decls

                aliases =
                    Array.mapAndKeepJust declarationToModuleAlias decls

                prims =
                    Array.mapAndKeepJust declarationToModulePrim decls

                externs =
                    Array.mapAndKeepJust declarationToModuleExtern decls
            in
            { name = name
            , exports = exports
            , docs = docs
            , imports = imports
            , values = values
            , classes = classes
            , instances = instances
            , unions = unions
            , aliases = aliases
            , prims = prims
            , externs = externs
            , binops = binops
            }
        )
        -- Every keyword in this module is matched with `Variable.keyword`
        -- rather than `token`, so that it needs a word boundary after it. With
        -- `token`, an ordinary declaration named `importantThing` or `infixOf`
        -- matched the keyword's prefix, committed the branch, and then failed
        -- on the rest of the name. The boundary has to be this module's own —
        -- `String.Parser`'s ends a word at `Char.isAlphaNum`, which is ASCII,
        -- and would split `typeé` the same way `token` split `infixOf`.
        --
        -- `port module` and `effect module` are refused rather than read (D280,
        -- geng-lang `m1b-source.md` §SO20), and `port` is an ordinary name
        -- (D279), so the refusal is the two words together.
        |> Parser.skip
            (Parser.oneOf
                [ removedHeaderParser "port"
                , removedHeaderParser "effect"
                , Parser.succeed {}
                ]
            )
        |> Parser.skip (Variable.keyword "module" (ExpectedKeyword "module"))
        |> Parser.skip spaceParser
        |> Parser.keep moduleNameParser
        |> Parser.skip spaceParser
        |> Parser.keep parseExposingStatement
        |> Parser.skip spaceParser
        |> Parser.keep (Declaration.docParser ExpectedKeyword)
        |> Parser.skip spaceParser
        |> Parser.keep (Parser.loop [] importLoopParser)
        |> Parser.skip spaceParser
        |> Parser.keep (Parser.loop [] operatorLoopParser)
        |> Parser.skip spaceParser
        |> Parser.keep (Parser.loop [] declarationLoopParser)


moduleNameParser : Parser Context Error (SourcePosition.Located String)
moduleNameParser =
    SourcePosition.parser
        ( Variable.foreignUpper
            |> Parser.mapError VariableError
            |> Parser.map Variable.foreignVarToString
            |> Parser.andThen
                (\name ->
                    -- D171: `Compiler.ModuleName.fromString`'s rule, ASCII
                    -- letters and digits, which is what a source file's name
                    -- already had to satisfy (`docs/m1b-str.md` §T24.5).
                    when ModuleName.fromString name is
                        Just _ ->
                            Parser.succeed name

                        Nothing ->
                            Parser.problem (InvalidModuleName name)
                )
        )


removedHeaderParser : String -> Parser Context Error {}
removedHeaderParser word =
    Parser.succeed {}
        |> Parser.skip (Variable.keyword word (ExpectedKeyword word))
        |> Parser.skip spaceParser
        |> Parser.skip (Variable.keyword "module" (ExpectedKeyword "module"))
        |> Parser.andThen (\_ -> Parser.problem (RemovedModuleHeader (word ++ " module")))


parseExposingStatement : Parser Context Error AST.Exposing
parseExposingStatement =
    Parser.succeed identity
        |> Parser.skip (Variable.keyword "exposing" (ExpectedKeyword "exposing"))
        |> Parser.skip spaceParser
        |> Parser.skip (Parser.chompChar '(' (ExpectedChar '('))
        |> Parser.skip spaceParser
        |> Parser.keep
            (Parser.oneOf
                [ Parser.succeed AST.Open
                    |> Parser.skip (Parser.token ".." (ExpectedKeyword ".."))
                    |> Parser.skip spaceParser
                    |> Parser.skip (Parser.chompChar ')' (ExpectedChar ')'))
                , Parser.succeed AST.Explicit
                    |> Parser.keep
                        (parseExposingValue
                            |> Parser.skip spaceParser
                            |> Parser.andThen
                                (\firstExposing ->
                                    Parser.loop [ firstExposing ] parseExposingArray
                                )
                        )
                ]
            )

    
parseExposingArray : Array AST.Exposed -> Parser Context Error (Parser.Step (Array AST.Exposed) (Array AST.Exposed))
parseExposingArray exps =
    Parser.oneOf
        [ Parser.succeed (Parser.Done exps)
            |> Parser.skip (Parser.chompChar ')' (ExpectedChar ')'))
        , Parser.succeed (\next -> Parser.Loop <| Array.pushLast next exps)
            |> Parser.skip (Parser.chompChar ',' (ExpectedChar ','))
            |> Parser.skip spaceParser
            |> Parser.keep parseExposingValue
            |> Parser.skip spaceParser
        ]


parseExposingValue : Parser Context Error AST.Exposed
parseExposingValue =
    Parser.oneOf
        [ Parser.succeed AST.ExposedLower
            |> Parser.keep
                (SourcePosition.parser Variable.lowerCase
                    |> Parser.mapError VariableError
                )
        , Parser.succeed (\name privacy -> AST.ExposedUpper { name = name, privacy = privacy })
            |> Parser.keep
                (SourcePosition.parser Variable.upperCase
                    |> Parser.mapError VariableError
                )
            |> Parser.skip spaceParser
            |> Parser.keep
                (Parser.oneOf
                    [ Parser.succeed AST.Public
                        |> Parser.skip (Parser.chompChar '(' (ExpectedChar '('))
                        |> Parser.skip spaceParser
                        |> Parser.skip (Parser.token ".." (ExpectedKeyword ".."))
                        |> Parser.skip spaceParser
                        |> Parser.skip (Parser.chompChar ')' (ExpectedChar ')'))
                    , Parser.succeed AST.Private
                    ]
                )
        , Parser.succeed AST.ExposedOperator
            |> Parser.skip (Parser.chompChar '(' (ExpectedChar '('))
            |> Parser.keep
                (SourcePosition.parser Operator.parser
                    |> Parser.mapError OperatorError
                )
            |> Parser.skip (Parser.chompChar ')' (ExpectedChar ')'))
        ]


parseAssociativity : Parser Context Error AST.BinopAssociativity
parseAssociativity =
    Parser.oneOf
        [ Parser.succeed AST.OpALeft
            |> Parser.skip (Variable.keyword "left" (ExpectedKeyword "left"))
        , Parser.succeed AST.OpARight
            |> Parser.skip (Variable.keyword "right" (ExpectedKeyword "right"))
        , Parser.succeed AST.OpANone
            |> Parser.skip (Variable.keyword "non" (ExpectedKeyword "non"))
        ]


parsePrecedence : Parser Context Error Int
parsePrecedence =
    Number.parser
        |> Parser.mapError (\_ -> ExpectedIntPrecedence)
        |> Parser.andThen
            (\outcome ->
                when outcome is
                    Number.Integer record ->
                        when String.toInt record.text is
                            Just int ->
                                Parser.succeed int

                            Nothing ->
                                Parser.problem ExpectedIntPrecedence

                    _ ->
                        Parser.problem ExpectedIntPrecedence
            )


parseOperatorDeclaration : Parser Context Error (SourcePosition.Located AST.Infix)
parseOperatorDeclaration =
    Parser.succeed (\start assoc prec op func end ->
        SourcePosition.at start end
            { fn = func.value
            , symbol = op.value
            , associativity = assoc
            , precedence = prec
            }
    )
        |> Parser.keep Parser.getPosition
        |> Parser.skip (Variable.keyword "infix" (ExpectedKeyword "infix"))
        |> Parser.skip spaceParser
        |> Parser.keep parseAssociativity
        |> Parser.skip spaceParser
        |> Parser.keep parsePrecedence
        |> Parser.skip spaceParser
        |> Parser.skip (Parser.chompChar '(' (ExpectedChar '('))
        |> Parser.keep (SourcePosition.parser Operator.parser |> Parser.mapError OperatorError)
        |> Parser.skip (Parser.chompChar ')' (ExpectedChar ')'))
        |> Parser.skip spaceParser
        |> Parser.skip (Parser.chompChar '=' (ExpectedChar '='))
        |> Parser.skip spaceParser
        |> Parser.keep (SourcePosition.parser Variable.lowerCase |> Parser.mapError VariableError)
        |> Parser.keep Parser.getPosition


importLoopParser
    : Array (SourcePosition.Located AST.Import)
    -> Parser Context Error (Parser.Step (Array (SourcePosition.Located  AST.Import)) (Array (SourcePosition.Located  AST.Import)))
importLoopParser imps =
    Parser.oneOf
        [ Parser.succeed
            (\start moduleName ->
                SourcePosition.at
                    start
                    moduleName.end
                    { module_ = moduleName
                    , alias = Nothing
                    , expose = AST.Explicit []
                    }
            )
            -- The `import` keyword's own position, not the module name's row
            -- forced to column 1: a newline between the keyword and the name
            -- is legal, and then the two are not on the same row.
            |> Parser.keep Parser.getPosition
            |> Parser.skip (Variable.keyword "import" (ExpectedKeyword "import"))
            |> Parser.skip spaceParser
            |> Parser.keep moduleNameParser
            |> Parser.skip spaceParser
            |> Parser.andThen
                (\baseImport ->
                    Parser.oneOf
                        [ Parser.succeed
                            (\alias ->
                                { baseImport
                                    | end = alias.end
                                    , value =
                                        { baseImport.value
                                            | alias = Just alias.value
                                        }
                                }
                            )
                            |> Parser.skip (Variable.keyword "as" (ExpectedKeyword "as"))
                            |> Parser.skip spaceParser
                            |> Parser.keep moduleNameParser
                            |> Parser.skip spaceParser
                        , Parser.succeed baseImport
                        ]
                )
            |> Parser.andThen
                (\importWithAlias ->
                    Parser.succeed
                        (\expose endPos ->
                            { importWithAlias
                                | end =
                                    -- implicitly check if we actually found an exposing list
                                    if expose == AST.Explicit [] then
                                        importWithAlias.end

                                    else
                                        endPos
                                , value =
                                    { importWithAlias.value
                                        | expose = expose
                                    }
                            }
                        )
                        |> Parser.keep
                            (Parser.oneOf
                                [ parseExposingStatement
                                , Parser.succeed (AST.Explicit [])
                                ]
                            )
                        |> Parser.keep Parser.getPosition
                        |> Parser.skip spaceParser
                )
            |> Parser.map
                (\finalImport ->
                    Parser.Loop <|
                        Array.pushLast finalImport imps
                )
        , Parser.succeed (Parser.Done imps)
        ]


operatorLoopParser
    : Array (SourcePosition.Located AST.Infix)
    -> Parser Context Error (Parser.Step (Array (SourcePosition.Located AST.Infix)) (Array (SourcePosition.Located AST.Infix)))
operatorLoopParser ops =
    Parser.oneOf
        [ Parser.succeed
            (\op ->
                Parser.Loop <|
                    Array.pushLast op ops
            )
            |> Parser.keep parseOperatorDeclaration
            |> Parser.skip spaceParser
        , Parser.succeed (Parser.Done ops)
        ]


declarationLoopParser
    : Array Declaration.Declaration
    -> Parser Context Error (Parser.Step (Array Declaration.Declaration) (Array Declaration.Declaration))
declarationLoopParser decls =
    Parser.oneOf
        [ Parser.succeed
            (\decl ->
                Parser.Loop <|
                    Array.pushLast decl decls
            )
            |> Parser.keep (Parser.mapError DeclarationError Declaration.parser)
            |> Parser.skip spaceParser
        , Parser.succeed (Parser.Done decls)
            |> Parser.skip (Parser.end ExpectedEnd)
        ]


declarationToModuleValue : Declaration -> Maybe (AST.ModuleDeclaration AST.Value)
declarationToModuleValue decl =
    when decl.value is
        Declaration.Value v ->
            let
                -- A value under `@capability` begins at the attribute, which
                -- is a row above its annotation's start.
                start =
                    if v.capability then
                        decl.start

                    else
                        when v.signature is
                            Nothing ->
                                v.name.start

                            Just ts ->
                                ts.start
            in
            Just <|
                SourcePosition.at
                    start
                    v.body.end
                    { docs = decl.docs
                    , value = v
                    }

        _ ->
            Nothing


declarationToModuleClass : Declaration -> Maybe (AST.ModuleDeclaration AST.Class)
declarationToModuleClass decl =
    when decl.value is
        Declaration.Class v ->
            let
                endPos =
                    Array.last v.methods
                        |> Maybe.map .end
                        |> Maybe.withDefault v.var.end
            in
            Just <|
                SourcePosition.at
                    decl.start
                    endPos
                    { docs = decl.docs
                    , value = v
                    }

        _ ->
            Nothing


declarationToModuleInstance : Declaration -> Maybe (AST.ModuleDeclaration AST.Instance)
declarationToModuleInstance decl =
    when decl.value is
        Declaration.Instance v ->
            let
                endPos =
                    Array.last v.methods
                        |> Maybe.map .end
                        |> Maybe.withDefault v.head.end
            in
            Just <|
                SourcePosition.at
                    decl.start
                    endPos
                    { docs = decl.docs
                    , value = v
                    }

        _ ->
            Nothing


declarationToModuleAlias : Declaration -> Maybe (AST.ModuleDeclaration AST.Alias)
declarationToModuleAlias decl =
    when decl.value is
        Declaration.Alias v ->
            Just <|
                SourcePosition.at
                    decl.start
                    v.type_.end
                    { docs = decl.docs
                    , value = v
                    }

        _ ->
            Nothing


declarationToModuleUnion : Declaration -> Maybe (AST.ModuleDeclaration AST.Union)
declarationToModuleUnion decl =
    when decl.value is
        Declaration.Union v ->
            let
                endPos =
                    Array.last v.variants
                        |> Maybe.map .end
                        |> Maybe.withDefault v.name.end
            in
            Just <|
                SourcePosition.at
                    decl.start
                    endPos
                    { docs = decl.docs
                    , value = v
                    }

        _ ->
            Nothing


declarationToModuleExtern : Declaration -> Maybe (AST.ModuleDeclaration AST.Extern)
declarationToModuleExtern decl =
    when decl.value is
        Declaration.Extern v ->
            Just <|
                SourcePosition.at
                    decl.start
                    (when v.definition is
                        Just def ->
                            def.body.end

                        Nothing ->
                            v.signature.end
                    )
                    { docs = decl.docs
                    , value = v
                    }

        _ ->
            Nothing


declarationToModulePrim : Declaration -> Maybe (AST.ModuleDeclaration AST.Prim)
declarationToModulePrim decl =
    when decl.value is
        Declaration.Prim v ->
            Just <|
                SourcePosition.at
                    decl.start
                    v.signature.end
                    { docs = decl.docs
                    , value = v
                    }

        _ ->
            Nothing


-- ERROR


{-| Use this when parsing fails to give the user a good idea
of where the parser failed, and why.

    import Compiler.Parse.Module as PM
    import Compiler.Parser.Context as Context
    import String.Parser.Advanced as Parser

    when Parser.run PM.parser Context.empty source is
        Ok _ -> 
            "Parsed OK"

        Err errs ->
            PM.errorsToString source errs 
-}
errorsToString : String -> Array (Parser.DeadEnd Context Error) -> String
errorsToString src deadEnds =
  String.join "" <|
    Parser.renderDeadEnds
      { text = identity
      , formatCaret = identity
      , formatContext = identity
      , newline = "\n"
      , linesOfExtraContext = 2
      }
      { deadEndToString = \de -> { row = de.row, col = de.col, context = "" }
      , problemToString = \err -> Parser.Other (errorToString err)
      }
      src
      (Array.map (\de -> { row = de.row, col = de.col, payload = {}, problem = de.problem }) deadEnds)
