module Compiler.Parse.Number exposing
    ( Outcome (..)
    , Error (..)
    , parser
    , zeroOrHigher
    , hexParser
    , hexDigits
    , errorToString
    )


{-| This module provides parsers for Gren numeric literals.

@docs parser, Outcome, Error, errorToString

## Specialized parsers

@docs zeroOrHigher, hexParser, hexDigits
-}


import String.Parser.Advanced as Parser exposing (Parser)
import Compiler.Parse.Context exposing (Context)


{-| The `parser` tolerates different kind of numbers: integers, floats and hex-encoded integers.

**An integer literal is carried as the text it was written as, not as a
number**, and `Hex` the same. A host `Int` is a double here, so accumulating
digits into one is wrong above `2^53` -- and wrong *silently*, which is how
`geng fmt` came to rewrite `9223372036854775807` as `9223372036854778000`
(`docs/m1a-fmt.md` §F12, `docs/m1b-int.md` §I14.5 and §I16). D2 gives Gren
integers this parser cannot hold in any one type: no single type covers both
`Int64.minValue` and `UInt64.maxValue`. So the parser says what was *written*
and the frontend that knows the literal's type decides what number it is, which
is what the `FloatingPoint` case has always done with its `text` and what D149
says about width. A caller that needs a small number -- an operator's
precedence, a unicode escape -- reads it back with `String.toInt`.
-}
type Outcome
    = Integer String
    | FloatingPoint { val : Float, text : String }
    | Hex String


{-| The kind of errors that can happen while parsing numbers.
-}
type Error
    = NotANumber
    | LeadingZero
    | ExpectedInt
    | ExpectedHex


{-| Returns a human-readable description of an `Error`.
-}
errorToString : Error -> String
errorToString error =
    when error is
        NotANumber ->
            "Not a valid number"
        
        LeadingZero ->
            "Leading zero is not allowed"
        
        ExpectedInt ->
            "Expected integer"
        
        ExpectedHex ->
            "Expected hexadecimal digits"


{-| Use this to parse numeric literals.

    String.Parser.run parser Compiler.Parse.Context.empty source
-}
parser : Parser Context Error Outcome
parser =
    Parser.oneOf
        [ Parser.succeed
            (\outcome ->
                when outcome is
                    Integer text ->
                        Integer ("-" ++ text)

                    FloatingPoint record ->
                        FloatingPoint { record | val = negate record.val, text = "-" ++ record.text }

                    Hex text ->
                        Hex ("-" ++ text)
            )
            |> Parser.skip (Parser.token "-" NotANumber)
            |> Parser.keep zeroOrHigher
        , zeroOrHigher
        ]
        |> Parser.andThen
            (\successCase ->
                Parser.oneOf
                    [ Parser.chompIf Char.isAlpha NotANumber
                        |> Parser.andThen (\_ -> Parser.problem NotANumber)
                    , Parser.succeed successCase
                    ]
            )


{-| Like `parser`, but does not support negative numbers.
-}
zeroOrHigher : Parser Context Error Outcome
zeroOrHigher =
    Parser.oneOf
        [ Parser.chompChar '0' NotANumber
            |> Parser.andThen
                (\_ ->
                    Parser.oneOf
                        [ Parser.chompChar 'x' NotANumber
                            |> Parser.andThen (\_ -> hexDigits ExpectedHex)
                            |> Parser.map (\digits -> Hex ("0x" ++ digits))
                        , Parser.chompChar '.' NotANumber
                            |> Parser.andThen (\_ -> fractalParser "0")
                        , exponentParser "0"
                        , Parser.chompIf Char.isDigit NotANumber
                            |> Parser.andThen (\_ -> Parser.problem LeadingZero)
                        , Parser.succeed (Integer "0")
                        ]
                )
        , Parser.chompIf Char.isDigit NotANumber
            |> Parser.skip (Parser.chompWhile Char.isDigit)
            |> Parser.getChompedString
            |> Parser.andThen
                (\str ->
                    Parser.oneOf
                        [ Parser.chompChar '.' NotANumber
                            |> Parser.andThen (\_ -> fractalParser str)
                        , exponentParser str
                        , Parser.succeed (Integer str)
                        ]
                )
        ]


fractalParser : String -> Parser Context Error Outcome
fractalParser str =
    Parser.chompIf Char.isDigit ExpectedInt
        |> Parser.skip (Parser.chompWhile Char.isDigit)
        |> Parser.getChompedString
        |> Parser.andThen
            (\postDot ->
                let
                    base = str ++ "." ++ postDot
                in
                Parser.oneOf
                    [ exponentParser base
                    , when String.toFloat base is
                        Nothing ->
                            Parser.problem NotANumber

                        Just float ->
                            Parser.succeed (FloatingPoint { val = float, text = base })
                    ]
            )


exponentParser : String -> Parser Context Error Outcome
exponentParser base =
    Parser.chompIf (\c -> c == 'e' || c == 'E') NotANumber
        |> Parser.getChompedString
        |> Parser.andThen
            (\eChar ->
                Parser.oneOf
                    [ Parser.chompChar '+' NotANumber
                        |> Parser.getChompedString
                    , Parser.chompChar '-' NotANumber
                        |> Parser.getChompedString
                    , Parser.succeed ""
                    ]
                |> Parser.andThen
                    (\sign ->
                        Parser.chompIf Char.isDigit ExpectedInt
                            |> Parser.skip (Parser.chompWhile Char.isDigit)
                            |> Parser.getChompedString
                            |> Parser.andThen
                                (\expDigits ->
                                    let
                                        fullText = base ++ eChar ++ sign ++ expDigits
                                    in
                                    when String.toFloat fullText is
                                        Nothing ->
                                            Parser.problem NotANumber

                                        Just float ->
                                            Parser.succeed (FloatingPoint { val = float, text = fullText })
                                )
                    )
            )

{-| A parser that only parses hex-encoded integers, like `0xAB`.

This one answers a number, and it stays that way because its callers are the
bounded ones: a `\u{...}` escape is at most `0x10FFFF`. A hex *literal* goes
through [zeroOrHigher](#zeroOrHigher) and comes back as text, for the reason
[parser](#parser) gives.
-}
hexParser : error -> Parser Context error Int
hexParser err =
    hexDigits err
        |> Parser.map (String.foldl hexFolder 0)


{-| The digits of a hex literal, as written.
-}
hexDigits : error -> Parser Context error String
hexDigits err =
    Parser.chompIf Char.isHexDigit err
        |> Parser.skip (Parser.chompWhile Char.isHexDigit)
        |> Parser.getChompedString


hexFolder : Char -> Int -> Int
hexFolder char acc =
    let
        charCode =
            Char.toCode char

        -- The digit's value, before it touches the accumulator. Adding the raw
        -- character code and subtracting the offset afterwards would run the
        -- intermediate up to 65 past the number being built, which just below
        -- 2^53 crosses into the range where a float64 has a spacing of 2: the
        -- intermediate rounds, and the trailing subtraction cannot undo it.
        digit =
            if charCode >= 48 && charCode <= 57 then
                -- 0-9
                charCode - 48

            else if charCode >= 65 && charCode <= 70 then
                -- A-F
                charCode - 55

            else if charCode >= 97 && charCode <= 102 then
                -- a-f
                charCode - 87

            else
                -- Unreachable: `hexParser` only chomps hex digits.
                -1
    in
    if digit < 0 then
        acc

    else
        16 * acc + digit
