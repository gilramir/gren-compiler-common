module Compiler.Parse.Space exposing
    ( Error (..)
    , parser
    , scopeIndentToLineStart
    , scopeIndentToColumn
    , checkIndent
    , errorToString
    , isBidiControl
    , firstBidiControl
    , codePointName
    )


{-| This module provides parsers for whitespace and comments in Gren code.

@docs parser, Error, errorToString

## Direction controls

@docs isBidiControl, firstBidiControl, codePointName

## Indentation helpers

@docs scopeIndentToLineStart, scopeIndentToColumn, checkIndent
-}


import Compiler.Parse.Context as Context exposing (Context)
import String.Parser.Advanced as Parser exposing (Parser)
import Dict
import Compiler.SourcePosition as SourcePosition
import Array.Builder


{-| The kind of errors that can happen while parsing whitespace and comments.
-}
type Error
    = ExpectedLineComment
    | ExpectedMultiLineOpen
    | ExpectedMultiLineClose
    | InvalidWhiteSpace
    | BidiControl Int


{-| Returns a human-readable description of an `Error`.
-}
errorToString : Error -> String
errorToString error =
    when error is
        ExpectedLineComment ->
            "Expected line comment"

        ExpectedMultiLineOpen ->
            "Expected {-"

        ExpectedMultiLineClose ->
            "Expected -}"
        
        InvalidWhiteSpace ->
            "Invalid whitespace character"

        BidiControl code ->
            "A comment has a direction control character, " ++ codePointName code ++ ", written as itself; take it out of the comment"


{-| Use this to parse whitespace and comments.
This will change `lineStart` and `comments` fields of `Context`.

    String.Parser.run parser Compiler.Parse.Context.empty source
-}
parser : Parser Context Error {}
parser =
    Parser.succeed (\startPos endPos -> { startPos = startPos, endPos = endPos })
        |> Parser.keep Parser.getPosition
        |> Parser.skip (Parser.loop {} parseLoop)
        |> Parser.keep Parser.getPosition
        |> Parser.andThen
            (\{ startPos, endPos } ->
                if startPos.row /= endPos.row || startPos.col == 1 then
                    Parser.succeed {}
                        |> Parser.updatePayload (\pl -> { pl | lineStart = endPos.col })

                else
                    Parser.succeed {}
            )


parseLoop : {} -> Parser Context Error (Parser.Step {} {})
parseLoop _state =
    Parser.oneOf
        [ Parser.succeed
            (\start comment end ->
                comment
                    |> String.dropFirst 2
                    |> Context.Line
                    |> SourcePosition.at start end
            )
            |> Parser.keep Parser.getPosition
            |> Parser.keep (Parser.getChompedString (Parser.lineComment "--" ExpectedLineComment) |> Parser.andThen refuseBidiControls)
            |> Parser.keep Parser.getPosition
            |> Parser.andThen
                (\value ->
                    Parser.updatePayload
                        (\payload  ->
                            { payload
                                | comments = Array.Builder.pushLast value payload.comments
                            }
                        )
                        Parser.getPayload
                )
            |> Parser.map (\_ -> Parser.Loop {})
        , Parser.succeed
            (\start comment end ->
                comment
                    |> String.dropFirst 2
                    |> String.dropLast 2
                    |> Context.Block
                    |> SourcePosition.at start end
            )
            |> Parser.keep Parser.getPosition
            |> Parser.skip
                (Parser.oneOf
                    [ Parser.token "{-|" ExpectedMultiLineOpen
                        |> Parser.andThen (\_ -> Parser.problem ExpectedMultiLineOpen)
                    , Parser.succeed {}
                    ]
                    |> Parser.backtrackable
                )
            |> Parser.keep
                (Parser.multiComment
                    { string = "{-", expecting = ExpectedMultiLineOpen }
                    { string = "-}", expecting = ExpectedMultiLineClose }
                    Parser.Nestable
                    |> Parser.getChompedString
                    |> Parser.andThen refuseBidiControls
                )
            |> Parser.keep Parser.getPosition
            |> Parser.andThen
                (\value ->
                    Parser.updatePayload
                        (\payload  ->
                            { payload
                                | comments = Array.Builder.pushLast value payload.comments
                            }
                        )
                        Parser.getPayload
                )
            |> Parser.map (\_ -> Parser.Loop {})
        , Parser.succeed (Parser.Loop {})
            |> Parser.skip (Parser.chompIf validWhiteSpace InvalidWhiteSpace)
            |> Parser.skip (Parser.chompWhile validWhiteSpace)
        , Parser.succeed (Parser.Done {})
        ]


{-| `text`, unless it has a direction control written in it (geng-lang D604). -}
refuseBidiControls : String -> Parser Context Error String
refuseBidiControls text =
    when firstBidiControl text is
        Just code ->
            Parser.problem (BidiControl code)

        Nothing ->
            Parser.succeed text


{-| The direction control `code` is, if it is one: U+202A to U+202E (LRE, RLE,
PDF, LRO, RLO) and U+2066 to U+2069 (LRI, RLI, FSI, PDI). Each changes the order
the text after it is displayed in, so a line can read differently from what the
compiler reads, and none may be written as itself in a literal or a comment
(geng-lang D604).
-}
isBidiControl : Int -> Bool
isBidiControl code =
    (code >= 0x202A && code <= 0x202E) || (code >= 0x2066 && code <= 0x2069)


{-| The first direction control written in `text`, if there is one. -}
firstBidiControl : String -> Maybe Int
firstBidiControl text =
    String.foldl
        (\c found ->
            when found is
                Just _ ->
                    found

                Nothing ->
                    if isBidiControl (Char.toCode c) then
                        Just (Char.toCode c)

                    else
                        Nothing
        )
        Nothing
        text


{-| `code` as `U+` and four upper-case hex digits. -}
codePointName : Int -> String
codePointName code =
    let
        digit d =
            String.slice d (d + 1) "0123456789ABCDEF"

        hex n =
            if n < 16 then
                digit n

            else
                hex (n // 16) ++ digit (modBy 16 n)
    in
    "U+" ++ String.padLeft 4 '0' (hex code)


validWhiteSpace : Char -> Bool
validWhiteSpace char =
    char == ' ' || char == '\n' || char == '\r'


{-| This will set `Context.indent` to be ´Context.startLine` for the duration of
the provided parser.
-}
scopeIndentToLineStart : Parser Context e v -> Parser Context e v
scopeIndentToLineStart p =
    Parser.scopedUpdatePayload
        .lineStart
        .indent
        (\newIndent payload -> { payload | indent = newIndent })
        p


{-| This will set `Context.indent` to the current column for the duration of the
provided parser, so that what it reads past its first line must be to the right
of where it began. It is the Haskell parser's `withIndent`: a `when` reads its
branches under it, from the column of the first (D86).
-}
scopeIndentToColumn : Parser Context e v -> Parser Context e v
scopeIndentToColumn p =
    Parser.getCol
        |> Parser.andThen
            (\col ->
                Parser.scopedUpdatePayload
                    (\_ -> col)
                    .indent
                    (\newIndent payload -> { payload | indent = newIndent })
                    p
            )


{-| Use this to check that the current indentation is valid. That is, the current
column has to be greater than `Context.indent`.

This allows you to stop parsing when the indentation level decreases.
-}
checkIndent : Parser Context {} {}
checkIndent =
    Parser.succeed (\indent col -> { indent = indent, col = col })
        |> Parser.keep (Parser.map .indent Parser.getPayload)
        |> Parser.keep Parser.getCol
        |> Parser.andThen
            (\{ indent, col } ->
                if col > indent then
                    Parser.succeed {}

                else
                    Parser.problem {}
            )
