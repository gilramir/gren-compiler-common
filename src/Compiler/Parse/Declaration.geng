module Compiler.Parse.Declaration exposing
    ( Declaration
    , DeclarationValue (..)
    , Error (..)
    , parser
    , docParser
    , errorToString
    )


{-| This module provides parsers for Gren declarations (values, types, etc.).

@docs Declaration, DeclarationValue, parser, docParser, Error, errorToString
-}


import String.Parser.Advanced as Parser exposing (Parser)
import Compiler.Ast.Source as AST
import Compiler.SourcePosition as SourcePosition
import Compiler.Parse.Space as Space
import Compiler.Parse.Variable as Variable
import Compiler.Parse.Pattern as Pattern
import Compiler.Parse.String as String
import Compiler.Parse.Type as Type
import Compiler.Parse.Expression as Expr
import Compiler.Parse.Context exposing (Context)


{-| A `Declaration` is a top-level definition in a module. Like type- or
function definitions. Each declaration can have a documentation comment.
-}
type alias Declaration =
    { docs : Maybe (SourcePosition.Located String)
    , start : SourcePosition.Position
    , value : DeclarationValue
    }


{-| The actual declaration, without documentation comment.
-}
type DeclarationValue
    = Alias AST.Alias
    | Union AST.Union
    | Value AST.Value
    | Class AST.Class
    | Instance AST.Instance
    | Prim AST.Prim
    | Extern AST.Extern


{-| The kind of errors that can happen while parsing declarations.
-}
type Error
    = ExpectedKeyword String
    | ExpectedChar Char
    | VariableError Variable.Error
    | TypeError Type.Error
    | ExprError Expr.Error
    | StringError String.Error
    | SpaceError Space.Error
    | IndentationError
    | UnknownAttribute String
    | AttributeNotOnCustomType
    | AttributeNeedsFreshLine
    | AttributeAfterExtern String
    | CapabilityWithoutAnnotation
    | InstanceMethodHasSignature String


{-| Returns a human-readable description of an `Error`.
-}
errorToString : Error -> String
errorToString error =
    when error is
        ExpectedKeyword keyword ->
            "Expected keyword '" ++ keyword ++ "'"
        
        ExpectedChar char ->
            "Expected character '" ++ String.fromChar char ++ "'"
        
        VariableError varError ->
            Variable.errorToString varError
        
        TypeError typeError ->
            Type.errorToString typeError
        
        ExprError exprError ->
            Expr.errorToString exprError

        StringError strError ->
            String.errorToString strError
        
        SpaceError spaceError ->
            Space.errorToString spaceError

        IndentationError ->
            "Expected more indentation than above line"

        UnknownAttribute name ->
            "Unknown attribute '@" ++ name ++ "'"

        AttributeNotOnCustomType ->
            "Expected a custom type after this attribute"

        AttributeNeedsFreshLine ->
            "Expected the declaration on the line after this attribute"

        AttributeAfterExtern name ->
            "Only '@extern' and '@externPure' may follow an '@extern', and this is '@" ++ name ++ "'"

        CapabilityWithoutAnnotation ->
            "Expected a type annotation on the value under '@capability'"

        InstanceMethodHasSignature name ->
            "'" ++ name ++ "' has a type annotation, and a method of an instance takes none"


spaceParser : Parser Context Error {}
spaceParser =
    Parser.mapError SpaceError Space.parser


{-| Use this to parse declarations.

    String.Parser.run parser Compiler.Parse.Context.empty source
-}
parser : Parser Context Error Declaration
parser =
    Parser.succeed
        (\docs start attribute ->
            { docs = docs
            , start = start
            , attribute = attribute
            }
        )
        |> Parser.keep (docParser ExpectedKeyword)
        -- Where the declaration itself begins, after any documentation comment.
        -- It cannot be recovered from the declaration's name: `type`,
        -- `type alias` and `port` all put a keyword first, and a newline
        -- between the keyword and the name is legal.
        |> Parser.keep Parser.getPosition
        |> Parser.keep attributeParser
        |> Parser.andThen declarationValueParser


declarationValueParser : { docs : Maybe (SourcePosition.Located String), start : SourcePosition.Position, attribute : Attribute } -> Parser Context Error Declaration
declarationValueParser { docs, start, attribute } =
    let
        finish value =
            { docs = docs
            , start = start
            , value = value
            }
    in
    when attribute is
        -- `@derive` says which classes an abstract type derives, so the
        -- declaration it is attached to has to be a custom type. Anything else
        -- is a misplaced attribute rather than a declaration that quietly
        -- ignores it.
        Derive derives ->
            Parser.oneOf
                [ typeParser derives
                , Parser.problem AttributeNotOnCustomType
                ]
                |> Parser.map finish

        -- No fallback list: `@prim` is followed by an annotation and nothing
        -- else, so an error inside one is that error rather than "this is not
        -- a primitive declaration".
        Prim_ primName ->
            primParser primName
                |> Parser.map finish

        -- Further rows can only be externs, and then the annotation.
        Extern_ first ->
            externParser first
                |> Parser.map finish

        -- A capability is minted by an ordinary value (D258), so what follows
        -- is a value declaration and nothing else.
        --
        -- The annotation starts where its name does, on a row after the
        -- attribute's, not at the `@`: the formatter anchors the name there, and
        -- at the `@` a comment written after `@capability` sorted after it.
        Capability_ ->
            Parser.getPosition
                |> Parser.andThen (\sigStart -> valueParser True sigStart)
                |> Parser.andThen
                    (\value ->
                        when value is
                            Value v ->
                                when v.signature is
                                    Nothing ->
                                        Parser.problem CapabilityWithoutAnnotation

                                    Just _ ->
                                        Parser.succeed value

                            _ ->
                                Parser.succeed value
                    )
                |> Parser.map finish

        NoAttribute ->
            Parser.oneOf
                [ typeParser []
                , classParser
                , instanceParser
                , valueParser False start
                ]
                |> Parser.map finish


valueParser : Bool -> SourcePosition.Position -> Parser Context Error DeclarationValue
valueParser capability start =
    Expr.letDefNamedParser
        |> Parser.mapError ExprError
        |> Parser.map
            (\def ->
                Value
                    { name = def.value.name
                    , capability = capability
                    , signature =
                        Maybe.map
                            (\t ->
                                { start = start
                                , constraints = t.constraints
                                , type_ = t.type_
                                }
                            )
                            def.value.typeSignature
                    , args = def.value.args
                    , body = def.value.body
                    }
            )


-- ATTRIBUTES


{-| The attributes the language has: `@derive(Eq, Ord, Inspect)` on a custom
type, `@prim("i32_add")` on an annotation (`core.md` C13), `@extern` and
`@externPure` on an annotation (`ffi.md` F1), and a bare `@capability` on a
value that mints a capability (D258).

An attribute follows the documentation comment and precedes the declaration.
-}
type Attribute
    = NoAttribute
    | Capability_
    | Derive (Array (SourcePosition.Located String))
    | Prim_ (SourcePosition.Located String)
    | Extern_ AST.ExternImpl


attributeParser : Parser Context Error Attribute
attributeParser =
    Parser.oneOf
        [ Parser.succeed identity
            |> Parser.skip (Parser.backtrackable (Parser.chompChar '@' (ExpectedChar '@')))
            |> Parser.keep (SourcePosition.parser lowerCaseVariable)
            |> Parser.andThen
                (\name ->
                    when name.value is
                        "derive" ->
                            Parser.map Derive (attributeArgsParser (Parser.loop [] deriveLoopParser))

                        "prim" ->
                            Parser.map Prim_ (attributeArgsParser primNameParser)

                        "capability" ->
                            Parser.map (\_ -> Capability_) bareAttributeEndParser

                        "extern" ->
                            Parser.map Extern_ (attributeArgsParser (externArgsParser False))

                        "externPure" ->
                            Parser.map Extern_ (attributeArgsParser (externArgsParser True))

                        _ ->
                            Parser.problem (UnknownAttribute name.value)
                )
        , Parser.succeed NoAttribute
        ]


{-| The end of an attribute with no arguments: the fresh line the declaration
starts on, as `attributeArgsParser` requires after the others.
-}
bareAttributeEndParser : Parser Context Error {}
bareAttributeEndParser =
    Parser.succeed (\nameRow declRow -> { nameRow = nameRow, declRow = declRow })
        |> Parser.keep Parser.getRow
        |> Parser.skip spaceParser
        |> Parser.keep Parser.getRow
        |> Parser.andThen
            (\{ nameRow = nameRow, declRow = declRow } ->
                if declRow <= nameRow then
                    Parser.problem AttributeNeedsFreshLine

                else
                    Parser.succeed {}
            )


{-| `(`, the attribute's own argument, `)`, and then the fresh line the
declaration starts on.
-}
attributeArgsParser : Parser Context Error a -> Parser Context Error a
attributeArgsParser argsParser =
    Parser.succeed (\args closeRow declRow -> { args = args, closeRow = closeRow, declRow = declRow })
        |> Parser.skip spaceParser
        |> Parser.skip (Parser.chompChar '(' (ExpectedChar '('))
        |> Parser.skip spaceParser
        |> Parser.keep argsParser
        |> Parser.keep Parser.getRow
        |> Parser.skip spaceParser
        |> Parser.keep Parser.getRow
        |> Parser.andThen
            (\{ args = args, closeRow = closeRow, declRow = declRow } ->
                -- The declaration goes on the row below the attribute. The
                -- Haskell front end requires a fresh line here too, and the two
                -- parsers have to accept the same language.
                if declRow <= closeRow then
                    Parser.problem AttributeNeedsFreshLine

                else
                    Parser.succeed args
            )


{-| The primitive's name, as a string literal, and then the closing paren that
`deriveLoopParser` consumes for the other attribute.

A string rather than a bare word because `i32_add` is not an identifier -- Gren
names have no underscores -- and inventing a second lexical class for the inside
of one attribute would be worse than quoting it.
-}
primNameParser : Parser Context Error (SourcePosition.Located String)
primNameParser =
    Parser.succeed identity
        |> Parser.keep (SourcePosition.parser (Parser.mapError StringError String.string))
        |> Parser.skip spaceParser
        |> Parser.skip (Parser.chompChar ')' (ExpectedChar ')'))


{-| `js, "geng_time", "now")`: a language and its names, then the closing
paren, as `primNameParser` ends on one.
-}
externArgsParser : Bool -> Parser Context Error AST.ExternImpl
externArgsParser isPure =
    Parser.succeed (\language names -> { pure = isPure, language = language, names = names })
        |> Parser.keep (SourcePosition.parser lowerCaseVariable)
        |> Parser.skip spaceParser
        |> Parser.keep (Parser.loop [] externNamesLoopParser)


externNamesLoopParser : Array (SourcePosition.Located String) -> Parser Context Error (Parser.Step (Array (SourcePosition.Located String)) (Array (SourcePosition.Located String)))
externNamesLoopParser names =
    Parser.oneOf
        [ Parser.succeed (\name -> Parser.Loop (Array.pushLast name names))
            |> Parser.skip (Parser.chompChar ',' (ExpectedChar ','))
            |> Parser.skip spaceParser
            |> Parser.keep (SourcePosition.parser (Parser.mapError StringError String.string))
            |> Parser.skip spaceParser
        , Parser.succeed (Parser.Done names)
            |> Parser.skip (Parser.chompChar ')' (ExpectedChar ')'))
        ]


{-| The rest of an extern declaration: more `@extern` rows, then the name, the
colon and the type, as `primParser` reads them, and then the Geng body if one
follows (D222).
-}
externParser : AST.ExternImpl -> Parser Context Error DeclarationValue
externParser first =
    Parser.succeed
        (\impls name tipe ->
            { name = name
            , impls = impls
            , signature = tipe
            }
        )
        |> Parser.keep (Parser.loop [ first ] moreExternsLoopParser)
        |> Parser.keep (SourcePosition.parser lowerCaseVariable)
        |> Parser.skip spaceParser
        |> Parser.skip (Parser.chompChar ':' (ExpectedChar ':'))
        |> Parser.skip spaceParser
        |> Parser.keep (Parser.mapError TypeError Type.expression)
        |> Parser.andThen
            (\declared ->
                Parser.map
                    (\definition ->
                        Extern
                            { name = declared.name
                            , impls = declared.impls
                            , signature = declared.signature
                            , definition = definition
                            }
                    )
                    (externDefinitionParser declared.name.value)
            )


{-| An equation for the extern's own name on a fresh line, or nothing. Only the
name is read backtrackably, so a following declaration with another name is left
whole, and an error inside the equation is that error.
-}
externDefinitionParser : String -> Parser Context Error (Maybe { name : SourcePosition.Located String, args : Array AST.Pattern, body : AST.Expression })
externDefinitionParser name =
    Parser.oneOf
        [ Parser.succeed (\defName def -> Just { name = defName, args = def.args, body = def.body })
            |> Parser.keep
                (Parser.backtrackable
                    (Parser.succeed identity
                        |> Parser.skip spaceParser
                        |> Parser.keep (SourcePosition.parser lowerCaseVariable)
                        |> Parser.andThen
                            (\defName ->
                                if defName.value == name && defName.start.col == 1 then
                                    Parser.succeed defName

                                else
                                    Parser.problem (ExpectedKeyword name)
                            )
                    )
                )
            |> Parser.skip spaceParser
            |> Parser.keep (Parser.mapError ExprError Expr.defArgsAndBodyParser)
        , Parser.succeed Nothing
        ]


moreExternsLoopParser : Array AST.ExternImpl -> Parser Context Error (Parser.Step (Array AST.ExternImpl) (Array AST.ExternImpl))
moreExternsLoopParser impls =
    Parser.oneOf
        [ Parser.succeed identity
            |> Parser.skip (Parser.backtrackable (Parser.chompChar '@' (ExpectedChar '@')))
            |> Parser.keep (SourcePosition.parser lowerCaseVariable)
            |> Parser.andThen
                (\name ->
                    when name.value is
                        "extern" ->
                            Parser.map (\impl -> Parser.Loop (Array.pushLast impl impls)) (attributeArgsParser (externArgsParser False))

                        "externPure" ->
                            Parser.map (\impl -> Parser.Loop (Array.pushLast impl impls)) (attributeArgsParser (externArgsParser True))

                        _ ->
                            Parser.problem (AttributeAfterExtern name.value)
                )
        , Parser.succeed (Parser.Done impls)
        ]


deriveLoopParser : Array (SourcePosition.Located String) -> Parser Context Error (Parser.Step (Array (SourcePosition.Located String)) (Array (SourcePosition.Located String)))
deriveLoopParser classes =
    Parser.succeed (\class_ step -> step (Array.pushLast class_ classes))
        |> Parser.keep (SourcePosition.parser upperCaseVariable)
        |> Parser.skip spaceParser
        |> Parser.keep
            (Parser.oneOf
                [ Parser.succeed Parser.Loop
                    |> Parser.skip (Parser.chompChar ',' (ExpectedChar ','))
                    |> Parser.skip spaceParser
                , Parser.succeed Parser.Done
                    |> Parser.skip (Parser.chompChar ')' (ExpectedChar ')'))
                ]
            )


-- CLASSES


{-| `class Eq a where` and the annotations under it, or `class Num a` alone.

`class` is a contextual keyword rather than a reserved word, so the head —
`class`, space, an upper-case name — is `backtrackable`: anything else is a
value named `class`, which `Html.Attributes` and `Svg.Attributes` both are.

The body is optional (D133), for the same reason and by the same means as an
annotation's context: `classes.md` §1.2's closed classes have no methods, so
`class Num a` has to be a declaration, and `where` is several tokens past the
point where the two shapes diverge. So the whole `where`-block is
`backtrackable` and a class with no body costs one failed attempt.
-}
classParser : Parser Context Error DeclarationValue
classParser =
    Parser.succeed
        (\name var methods ->
            Class
                { name = name
                , var = var
                , methods = methods
                }
        )
        |> Parser.keep
            (Parser.backtrackable
                (Parser.succeed identity
                    |> Parser.skip (Variable.keyword "class" (ExpectedKeyword "class"))
                    |> Parser.skip spaceParser
                    |> Parser.keep (SourcePosition.parser upperCaseVariable)
                )
            )
        |> Parser.skip spaceParser
        |> Parser.keep (indentedParser (SourcePosition.parser lowerCaseVariable))
        |> Parser.keep
            (Parser.oneOf
                [ Parser.backtrackable
                    (Parser.succeed identity
                        |> Parser.skip spaceParser
                        |> Parser.skip (indentedParser (Variable.keyword "where" (ExpectedKeyword "where")))
                        |> Parser.skip spaceParser
                        |> Parser.keep (blockParser classMethodParser)
                    )
                , Parser.succeed []
                ]
            )


{-| The members of a `class` or `instance` body: an indented block, every
member starting in the same column as the first.

The column rule is what ends the block. Without it the loop keeps reading
whatever follows the declaration — a top-level `x : Int` parses perfectly well
as another class method — and the declaration below silently becomes a member
of the one above it. The Haskell front end says the same thing with
`Space.checkAligned`.
-}
blockParser : Parser Context Error a -> Parser Context Error (Array a)
blockParser memberParser =
    Parser.getCol
        |> Parser.andThen
            (\bodyCol ->
                if bodyCol <= 1 then
                    Parser.problem IndentationError

                else
                    Space.scopeIndentToLineStart memberParser
                        |> Parser.andThen
                            (\firstMember ->
                                Parser.succeed identity
                                    |> Parser.skip spaceParser
                                    |> Parser.keep
                                        (Parser.loop [ firstMember ] (blockLoopParser bodyCol memberParser))
                            )
            )


blockLoopParser : Int -> Parser Context Error a -> Array a -> Parser Context Error (Parser.Step (Array a) (Array a))
blockLoopParser bodyCol memberParser members =
    Parser.oneOf
        [ Parser.succeed
            (\member -> Parser.Loop (Array.pushLast member members))
            |> Parser.keep
                (Parser.backtrackable
                    (Parser.succeed identity
                        |> Parser.skip (atColumn bodyCol)
                        |> Parser.keep (Space.scopeIndentToLineStart memberParser)
                    )
                )
            |> Parser.skip spaceParser
        , Parser.succeed (Parser.Done members)
        ]


atColumn : Int -> Parser Context Error {}
atColumn col =
    Parser.getCol
        |> Parser.andThen
            (\actual ->
                if actual == col then
                    Parser.succeed {}

                else
                    Parser.problem IndentationError
            )


{-| A method's own line sets the indent for its annotation, so a type that runs
past the end of the line still parses and the next method at the same column
still ends it. `Space.scopeIndentToLineStart` is what `let` already does for
its definitions.
-}
classMethodParser : Parser Context Error (SourcePosition.Located AST.ClassMethod)
classMethodParser =
    Parser.succeed
        (\name signature ->
            SourcePosition.at
                name.start
                signature.type_.end
                { name = name
                , signature = signature
                }
        )
        |> Parser.keep (SourcePosition.parser lowerCaseVariable)
        |> Parser.skip spaceParser
        |> Parser.skip (Parser.chompChar ':' (ExpectedChar ':'))
        |> Parser.skip spaceParser
        |> Parser.keep (Parser.mapError TypeError Type.annotation)


-- INSTANCES


{-| `instance Eq a => Eq (Array a) where` and the definitions under it.

The head is parsed as an annotation, which is what it is: an optional context
and then a type. Whether that type's head names a class is a question for the
environment rather than for the parser.
-}
instanceParser : Parser Context Error DeclarationValue
instanceParser =
    Parser.succeed
        (\head methods ->
            Instance
                { constraints = head.constraints
                , head = head.type_
                , methods = methods
                }
        )
        |> Parser.keep
            (Parser.backtrackable
                (Parser.succeed identity
                    |> Parser.skip (Variable.keyword "instance" (ExpectedKeyword "instance"))
                    |> Parser.skip spaceParser
                    |> Parser.keep (Parser.mapError TypeError Type.annotation)
                )
            )
        |> Parser.skip (Variable.keyword "where" (ExpectedKeyword "where"))
        |> Parser.skip spaceParser
        |> Parser.keep (blockParser instanceMethodParser)


instanceMethodParser : Parser Context Error (SourcePosition.Located AST.DefineRecord)
instanceMethodParser =
    Expr.letDefNamedParser
        |> Parser.mapError ExprError
        |> Parser.andThen
            (\def ->
                when def.value.typeSignature is
                    Just _ ->
                        Parser.problem (InstanceMethodHasSignature def.value.name.value)

                    Nothing ->
                        Parser.succeed def
            )


{-| Use this to parse documentation comments.

    String.Parser.run (docParser ExpectedKeyword) Compiler.Parse.Context.empty source
-}
docParser : (String -> err) -> Parser Context err (Maybe (SourcePosition.Located String))
docParser toErr =
    let
        spaceErr : Space.Error -> err
        spaceErr spaceError =
            when spaceError is
                Space.ExpectedLineComment ->
                    toErr "expected line comment"

                Space.ExpectedMultiLineOpen ->
                    toErr "expected {-"

                Space.ExpectedMultiLineClose ->
                    toErr "expected -}"

                Space.InvalidWhiteSpace ->
                    toErr "expected white space character"
    in
    Parser.oneOf
        [ Parser.succeed
            (\docStart doc docEnd ->
                let
                    trimmedDoc =
                        doc
                            |> String.dropFirst 3
                            |> String.dropLast 2
                in
                Just <|
                    SourcePosition.at docStart docEnd trimmedDoc
            )
            |> Parser.keep Parser.getPosition
            |> Parser.keep
                (Parser.multiComment
                    -- Since Space.parser has run before this parser, we can assume
                    -- that {- means {-|
                    { string = "{-", expecting = toErr "{-|" }
                    { string = "-}", expecting = toErr "-}" }
                    Parser.Nestable
                    |> Parser.getChompedString
                )
            |> Parser.keep Parser.getPosition
            |> Parser.skip (Parser.mapError spaceErr Space.parser)
        , Parser.succeed Nothing
        ]


typeParser : Array (SourcePosition.Located String) -> Parser Context Error DeclarationValue
typeParser derives =
    Parser.succeed identity
        |> Parser.skip (Variable.keyword "type" (ExpectedKeyword "type"))
        |> Parser.skip spaceParser
        |> Parser.keep
            (Parser.oneOf
                [ -- A type alias is transparent, so whatever it stands for
                  -- already derives structurally and `@derive` on one is a
                  -- redundancy rather than a no-op.
                  if Array.isEmpty derives then
                    aliasParser

                  else
                    Parser.succeed identity
                        |> Parser.skip (Parser.backtrackable (Variable.keyword "alias" (ExpectedKeyword "alias")))
                        |> Parser.keep (Parser.problem AttributeNotOnCustomType)
                , unionParser derives
                ]
            )


aliasParser : Parser Context Error DeclarationValue
aliasParser =
    Parser.succeed
        (\name vars tipe ->
            Alias
                { name = name
                , vars = vars
                , type_ = tipe
                }
        )
        |> Parser.skip (Variable.keyword "alias" (ExpectedKeyword "alias"))
        |> Parser.skip spaceParser
        |> Parser.keep (SourcePosition.parser upperCaseVariable)
        |> Parser.skip spaceParser
        |> Parser.keep (Parser.loop [] typeArgLoopParser)
        |> Parser.skip spaceParser
        |> Parser.keep (Parser.mapError TypeError Type.expression)


typeArgLoopParser : Array (SourcePosition.Located String) -> Parser Context Error (Parser.Step (Array (SourcePosition.Located String)) (Array (SourcePosition.Located String)))
typeArgLoopParser vars =
    -- Held to the enclosing indentation, as the Haskell parser holds a type's
    -- head: a variable or the `=` in column 1 starts no declaration there, and
    -- it did here (upstream's `type-head-column-one` report).
    indentedParser
        (Parser.oneOf
            [ Parser.succeed (Parser.Done vars)
                |> Parser.skip (Parser.chompChar '=' (ExpectedChar '='))
            , Parser.succeed
                (\var -> Parser.Loop <| Array.pushLast var vars)
                |> Parser.keep (SourcePosition.parser lowerCaseVariable)
                |> Parser.skip spaceParser
            ]
        )


{-| A parser that must start past the enclosing indentation. -}
indentedParser : Parser Context Error a -> Parser Context Error a
indentedParser parser_ =
    Parser.succeed identity
        |> Parser.skip (Parser.mapError (\_ -> IndentationError) Space.checkIndent)
        |> Parser.keep parser_


unionParser : Array (SourcePosition.Located String) -> Parser Context Error DeclarationValue
unionParser derives =
    Parser.succeed
        (\name vars variants ->
            Union
                { name = name
                , vars = vars
                , variants = variants
                , derives = derives
                }
        )
        |> Parser.keep (SourcePosition.parser upperCaseVariable)
        |> Parser.skip spaceParser
        |> Parser.keep (Parser.loop [] typeArgLoopParser)
        |> Parser.skip spaceParser
        |> Parser.keep
            (variantParser
                |> Parser.andThen
                    (\firstVariant ->
                        (Parser.loop [ firstVariant ] variantLoopParser)
                    )
            )


variantParser : Parser Context Error (SourcePosition.Located AST.UnionVariant)
variantParser =
    Parser.succeed
        (\name payload ->
            let
                variantEnd =
                    payload
                        |> Maybe.map .end
                        |> Maybe.withDefault name.end
            in
            SourcePosition.at
                name.start
                variantEnd
                { name = name
                , payload = payload
                }
        )
        |> Parser.keep (SourcePosition.parser upperCaseVariable)
        |> Parser.skip spaceParser
        |> Parser.keep
            (Parser.oneOf
                [ Parser.succeed Just
                    |> Parser.skip (Parser.mapError (\_ -> IndentationError) Space.checkIndent)
                    |> Parser.keep (Parser.mapError TypeError Type.expression)
                , Parser.succeed Nothing
                ]
            )


variantLoopParser : Array (SourcePosition.Located AST.UnionVariant) -> Parser Context Error (Parser.Step (Array (SourcePosition.Located AST.UnionVariant)) (Array (SourcePosition.Located AST.UnionVariant)))
variantLoopParser variants =
    Parser.oneOf
        [ Parser.succeed
            (\variant -> Parser.Loop <| Array.pushLast variant variants)
            |> Parser.skip (Parser.chompChar '|' (ExpectedChar '|'))
            |> Parser.skip spaceParser
            |> Parser.keep variantParser
        , Parser.succeed (Parser.Done variants)
        ]


{-| `@prim("i32_add")` and the annotation under it (`core.md` C13).

The attribute has already been read; what is left is the name, the colon and
the type. There is no equation, because the primitive the attribute names is
the body.

`Type.expression` and not an annotation: a primitive is never constrained.
-}
primParser : SourcePosition.Located String -> Parser Context Error DeclarationValue
primParser primName =
    Parser.succeed
        (\name tipe ->
            Prim
                { name = name
                , primName = primName
                , signature = tipe
                }
        )
        |> Parser.keep (SourcePosition.parser lowerCaseVariable)
        |> Parser.skip spaceParser
        |> Parser.skip (Parser.chompChar ':' (ExpectedChar ':'))
        |> Parser.skip spaceParser
        |> Parser.keep (Parser.mapError TypeError Type.expression)


lowerCaseVariable : Parser Context Error String
lowerCaseVariable =
    Parser.mapError VariableError Variable.lowerCase


upperCaseVariable : Parser Context Error String
upperCaseVariable =
    Parser.mapError VariableError Variable.upperCase
