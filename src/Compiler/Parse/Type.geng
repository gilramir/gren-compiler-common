module Compiler.Parse.Type exposing
    ( Error (..)
    , expression
    , term
    , annotation
    , errorToString
    )


{-| This module provides parsers for Gren type expressions.

@docs expression, term, annotation, Error, errorToString
-}


import Compiler.Parse.Context exposing (Context)
import String.Parser.Advanced as Parser exposing (Parser)
import Compiler.SourcePosition as SourcePosition
import Compiler.Ast.Source as AST
import Compiler.Parse.Variable as Variable
import Compiler.Parse.Number as Number
import Compiler.Parse.Operator as Operator
import Compiler.Parse.Space as Space


{-| The kind of errors that can happen while parsing types.
-}
type Error
    = ExpectedChar Char
    | ExpectedString String
    | VariableError Variable.Error
    | ExpectedIndent
    | SpaceError Space.Error
    | BadRefinement


{-| Returns a human-readable description of an `Error`.
-}
errorToString : Error -> String
errorToString error =
    when error is
        ExpectedChar char ->
            "Expected '" ++ String.fromChar char ++ "'"
        
        ExpectedString str ->
            "Expected string '" ++ str ++ "'"
        
        VariableError varError ->
            Variable.errorToString varError
        
        ExpectedIndent ->
            "Expected indentation"
        
        SpaceError spaceError ->
            Space.errorToString spaceError

        BadRefinement ->
            "Expected a refinement's predicate: integer literals, argument names, a measure applied to a name, True, False, not, a unary -, parentheses, and + - * < <= > >= == /= && ||"


spaceParser : Parser Context Error {}
spaceParser =
    Parser.mapError SpaceError Space.parser


{-| Use this to parse an annotation: a type, optionally qualified by a
constraint context.

    String.Parser.run annotation Compiler.Parse.Context.empty source

A context has to be recognized before it can be parsed, because both of its
shapes are already something else. `Eq a` is a perfectly good type, and `(`
opens a parenthesized type as readily as a constraint list; the only thing that
separates them is the `=>` several tokens later. So the whole context is
`backtrackable`, and an annotation with no context costs one failed attempt
over a handful of tokens.
-}
annotation : Parser Context Error AST.Annotation
annotation =
    Parser.succeed (\constraints tipe -> { constraints = constraints, type_ = tipe })
        |> Parser.keep
            (Parser.oneOf
                [ Parser.backtrackable context
                , Parser.succeed []
                ]
            )
        |> Parser.keep expression


context : Parser Context Error (Array AST.Constraint)
context =
    Parser.succeed identity
        |> Parser.keep
            (Parser.oneOf
                [ Parser.succeed identity
                    |> Parser.skip (Parser.chompChar '(' (ExpectedChar '('))
                    |> Parser.skip spaceParser
                    |> Parser.keep (Parser.loop [] constraintLoopParser)
                , constraint
                    |> Parser.map (\one -> [ one ])
                ]
            )
        |> Parser.skip spaceParser
        |> Parser.skip (Parser.token "=>" (ExpectedString "=>"))
        |> Parser.skip spaceParser


constraintLoopParser : Array AST.Constraint -> Parser Context Error (Parser.Step (Array AST.Constraint) (Array AST.Constraint))
constraintLoopParser constraints =
    Parser.succeed (\one step -> step (Array.pushLast one constraints))
        |> Parser.keep constraint
        |> Parser.keep
            (Parser.oneOf
                [ Parser.succeed Parser.Loop
                    |> Parser.skip (Parser.chompChar ',' (ExpectedChar ','))
                    |> Parser.skip spaceParser
                , Parser.succeed (\done -> Parser.Done done)
                    |> Parser.skip (Parser.chompChar ')' (ExpectedChar ')'))
                ]
            )


constraint : Parser Context Error AST.Constraint
constraint =
    Parser.succeed
        (\start var classEnd varStart name varEnd ->
            when var is
                Variable.Unqualified className ->
                    { qualifier = Nothing
                    , class = SourcePosition.at start classEnd className
                    , var = SourcePosition.at varStart varEnd name
                    }

                Variable.Qualified { module_, name = className } ->
                    { qualifier = Just module_
                    , class = SourcePosition.at start classEnd className
                    , var = SourcePosition.at varStart varEnd name
                    }
        )
        |> Parser.keep Parser.getPosition
        |> Parser.keep (Parser.mapError VariableError Variable.foreignUpper)
        |> Parser.keep Parser.getPosition
        |> Parser.skip spaceParser
        |> Parser.keep Parser.getPosition
        |> Parser.keep (Parser.mapError VariableError Variable.lowerCase)
        |> Parser.keep Parser.getPosition
        |> Parser.skip spaceParser


{-| Use this to parse type expressions.

    String.Parser.run expression Compiler.Parse.Context.empty source
-}
expression : Parser Context Error AST.Type
expression =
    Parser.oneOf
        [ app
        , term
        ]
        |> Parser.andThen
            (\tipe ->
                Parser.oneOf
                    [ Parser.succeed
                        (\next ->
                            SourcePosition.at
                                tipe.start
                                next.end
                                (AST.TLambda { from = tipe, to = next })
                        )
                        |> Parser.skip checkIndent
                        |> Parser.skip (Parser.token "->" (ExpectedString "->"))
                        |> Parser.skip spaceParser
                        |> Parser.skip checkIndent
                        |> Parser.keep (Parser.lazy (\_ -> expression))
                    , Parser.succeed tipe
                    ]
            )


checkIndent : Parser Context Error {}
checkIndent =
    Parser.mapError (\_ -> ExpectedIndent) Space.checkIndent


app : Parser Context Error AST.Type
app =
    Parser.succeed
        (\start var end args ->
            let
                argsEnd =
                    Array.last args
                        |> Maybe.map .end
                        |> Maybe.withDefault end
            in
            when var is
                Variable.Unqualified name ->
                    SourcePosition.at start argsEnd <|
                        AST.TType
                            { name = SourcePosition.at start end name
                            , args = args
                            }

                Variable.Qualified { module_, name } ->
                    SourcePosition.at start argsEnd <|
                        AST.TTypeQual
                            { varRegion = { start = start, end = end }
                            , qualifier = module_
                            , name = name
                            , args = args
                            }
        )
        |> Parser.keep Parser.getPosition
        |> Parser.keep (Parser.mapError VariableError Variable.foreignUpper)
        |> Parser.keep Parser.getPosition
        |> Parser.skip spaceParser
        |> Parser.keep (Parser.loop [] typeArgsParser)


typeArgsParser : Array AST.Type -> Parser Context Error (Parser.Step (Array AST.Type) (Array AST.Type))
typeArgsParser array =
    Parser.oneOf
        -- Each argument is a term, as the Haskell parser has it: read as a whole
        -- type, `Dict String Int -> Int` was `Dict (String (Int -> Int))` and
        -- `Maybe Maybe Int` was `Maybe (Maybe Int)`, which `gren make` reads as
        -- `Maybe` given two arguments (compiler-common#32's cause).
        [ Parser.succeed (\expr -> Parser.Loop (Array.pushLast expr array))
            |> Parser.skip (Parser.mapError (\_ -> ExpectedIndent) Space.checkIndent)
            |> Parser.keep term
            |> Parser.skip spaceParser
        , Parser.succeed {}
            |> Parser.map (\_ -> Parser.Done array)
        ]


{-| A type that needs no parentheses to be an argument: a name with no
arguments, a variable, a record or a parenthesized type.
-}
term : Parser Context Error AST.Type
term =
    Parser.getPosition
        |> Parser.andThen
            (\start ->
                Parser.oneOf
                    [ Parser.succeed
                        (\var end ->
                            SourcePosition.at
                                start
                                end
                                (when var is
                                    Variable.Unqualified name ->
                                        AST.TType
                                            { name = SourcePosition.at start end name
                                            , args = []
                                            }

                                    Variable.Qualified { module_, name } ->
                                        AST.TTypeQual
                                            { varRegion = { start = start, end = end }
                                            , qualifier = module_
                                            , name = name
                                            , args = []
                                            }
                                )
                        )
                        |> Parser.keep (Parser.mapError VariableError Variable.foreignUpper)
                        |> Parser.keep Parser.getPosition
                    , Parser.succeed (\var end -> SourcePosition.at start end (AST.TVar var))
                        |> Parser.keep (Parser.mapError VariableError Variable.lowerCase)
                        |> Parser.keep Parser.getPosition
                    , Parser.succeed (\inner end -> SourcePosition.at start end inner)
                        |> Parser.skip (Parser.chompChar '(' (ExpectedChar '('))
                        |> Parser.skip spaceParser
                        |> Parser.keep parenthesized
                        |> Parser.keep Parser.getPosition
                    , Parser.succeed (\record end -> SourcePosition.at start end record)
                        |> Parser.keep recordParser
                        |> Parser.keep Parser.getPosition
                    ]
                    |> Parser.skip spaceParser
            )


{-| What follows a `(` in a type: a named type, `(b : Bytes)` or
`(i : Int where 0 <= i)` (geng-lang `m4-refine.md` D814), or a parenthesized
one. A name followed by a colon is what tells them apart, since a type
variable is never followed by one, so that much is backtrackable and
`(a -> b)` costs one failed attempt.
-}
parenthesized : Parser Context Error AST.Type_
parenthesized =
    Parser.oneOf
        [ named
        , Parser.succeed AST.TParens
            |> Parser.keep (Parser.lazy (\_ -> expression))
            |> Parser.skip (Parser.chompChar ')' (ExpectedChar ')'))
        ]


named : Parser Context Error AST.Type_
named =
    Parser.succeed
        (\name tipe maybeRefinement ->
            AST.TNamed { name = name, type_ = tipe, refinement = maybeRefinement }
        )
        |> Parser.keep namedHead
        |> Parser.skip spaceParser
        |> Parser.keep (Parser.lazy (\_ -> expression))
        |> Parser.keep
            (Parser.oneOf
                [ Parser.succeed (\whereAt p -> Just { whereAt = whereAt, predicate = p })
                    |> Parser.keep Parser.getPosition
                    |> Parser.skip (Variable.keyword "where" (ExpectedString "where"))
                    |> Parser.skip spaceParser
                    |> Parser.keep predicate
                , Parser.succeed Nothing
                ]
            )
        |> Parser.skip (Parser.chompChar ')' (ExpectedChar ')'))


namedHead : Parser Context Error (SourcePosition.Located String)
namedHead =
    Parser.succeed identity
        |> Parser.keep (SourcePosition.parser (Parser.mapError VariableError Variable.lowerCase))
        |> Parser.skip spaceParser
        |> Parser.skip (Parser.chompChar ':' (ExpectedChar ':'))
        |> Parser.backtrackable



-- PREDICATES


{-| A refinement's predicate, read by its own grammar rather than by the
expression parser, which imports this module (D815). It holds what D808
allows: integer literals, names, a qualified function applied to one name (a
measure, `Bytes.length b`), `True`, `False`, `not`, unary `-`, the operators
`+ - * < <= > >= == /= && ||` and parentheses.

The operators are read as a chain nested to the left, as the expression parser
reads them, and are given their precedence where every chain is, so a
predicate is the expression it would be anywhere else. That `a < b < c` does
not type, or that a `*` needs a literal side, is for the checker to say.
-}
predicate : Parser Context Error AST.Expression
predicate =
    operand
        |> Parser.andThen (\first -> Parser.loop first predicateChain)


predicateChain : AST.Expression -> Parser Context Error (Parser.Step AST.Expression AST.Expression)
predicateChain left =
    Parser.oneOf
        [ Parser.succeed
            (\operator right ->
                Parser.Loop
                    (SourcePosition.at left.start
                        right.end
                        (AST.Binops { left = left, operator = operator, right = right })
                    )
            )
            |> Parser.keep (SourcePosition.parser predicateOperator)
            |> Parser.skip spaceParser
            |> Parser.keep operand
        , Parser.succeed (Parser.Done left)
        ]


predicateOperator : Parser Context Error String
predicateOperator =
    Operator.parser
        |> Parser.mapError (\_ -> BadRefinement)
        |> Parser.andThen
            (\op ->
                if Array.member op [ "+", "-", "*", "<", "<=", ">", ">=", "==", "/=", "&&", "||" ] then
                    Parser.succeed op

                else
                    Parser.problem BadRefinement
            )


{-| One operand of a predicate, and the space after it. -}
operand : Parser Context Error AST.Expression
operand =
    Parser.getPosition
        |> Parser.andThen
            (\start ->
                Parser.oneOf
                    [ Parser.succeed (\inner end -> SourcePosition.at start end (AST.Parens inner))
                        |> Parser.skip (Parser.chompChar '(' (ExpectedChar '('))
                        |> Parser.skip spaceParser
                        |> Parser.keep (Parser.lazy (\_ -> predicate))
                        |> Parser.skip (Parser.chompChar ')' (ExpectedChar ')'))
                        |> Parser.keep Parser.getPosition
                        |> Parser.skip spaceParser
                    , Parser.succeed (\inner -> SourcePosition.at start inner.end (AST.Negate inner))
                        |> Parser.skip (Parser.chompChar '-' BadRefinement)
                        |> Parser.keep (Parser.lazy (\_ -> operand))
                    , Parser.succeed (\number end -> SourcePosition.at start end (AST.NumberLiteral number))
                        |> Parser.keep integer
                        |> Parser.keep Parser.getPosition
                        |> Parser.skip spaceParser
                    , Parser.succeed identity
                        |> Parser.keep (Parser.mapError VariableError Variable.lowerCase)
                        |> Parser.andThen (\name -> lowerOperand start name)
                    , Parser.succeed identity
                        |> Parser.keep (Parser.mapError VariableError Variable.foreignVar)
                        |> Parser.andThen (\var -> upperOperand start var)
                    ]
            )


integer : Parser Context Error Number.Outcome
integer =
    Number.parser
        |> Parser.mapError (\_ -> BadRefinement)
        |> Parser.andThen
            (\number ->
                when number is
                    Number.FloatingPoint _ ->
                        Parser.problem BadRefinement

                    _ ->
                        Parser.succeed number
            )


{-| A name, or `not` and what it negates. -}
lowerOperand : SourcePosition.Position -> String -> Parser Context Error AST.Expression
lowerOperand start name =
    Parser.succeed (\end -> SourcePosition.at start end (AST.Var { name = name, varType = AST.LowVar }))
        |> Parser.keep Parser.getPosition
        |> Parser.skip spaceParser
        |> Parser.andThen
            (\var ->
                if name == "not" then
                    Parser.succeed
                        (\arg -> SourcePosition.at start arg.end (AST.Call { fn = var, args = [ arg ] }))
                        |> Parser.keep (Parser.lazy (\_ -> operand))

                else
                    Parser.succeed var
            )


{-| `True`, `False`, or a measure applied to a name: `Bytes.length b`. -}
upperOperand : SourcePosition.Position -> Variable.ForeignVar -> Parser Context Error AST.Expression
upperOperand start var =
    Parser.getPosition
        |> Parser.andThen
            (\end ->
                when var is
                    Variable.Unqualified name ->
                        if name == "True" || name == "False" then
                            Parser.succeed (SourcePosition.at start end (AST.Var { name = name, varType = AST.CapVar }))
                                |> Parser.skip spaceParser

                        else
                            Parser.problem BadRefinement

                    Variable.Qualified { module_, name } ->
                        if String.popFirst name |> Maybe.map (\{ first } -> Char.isLower first) |> Maybe.withDefault False then
                            let
                                fn =
                                    SourcePosition.at start end (AST.VarQual { varType = AST.LowVar, qualifier = module_, name = name })
                            in
                            Parser.succeed
                                (\argStart argName argEnd ->
                                    SourcePosition.at start
                                        argEnd
                                        (AST.Call
                                            { fn = fn
                                            , args = [ SourcePosition.at argStart argEnd (AST.Var { name = argName, varType = AST.LowVar }) ]
                                            }
                                        )
                                )
                                |> Parser.skip spaceParser
                                |> Parser.keep Parser.getPosition
                                |> Parser.keep (Parser.mapError VariableError Variable.lowerCase)
                                |> Parser.keep Parser.getPosition
                                |> Parser.skip spaceParser

                        else
                            Parser.problem BadRefinement
            )


recordParser : Parser Context Error AST.Type_
recordParser =
    Parser.succeed identity
        |> Parser.skip (Parser.chompChar '{' (ExpectedChar '{'))
        |> Parser.skip spaceParser
        |> Parser.keep
            (Parser.oneOf
                [ Parser.succeed (AST.TRecord { fields = [], extending = Nothing })
                    |> Parser.skip (Parser.chompChar '}' (ExpectedChar '}'))
                , Parser.succeed (\start var end -> SourcePosition.at start end var)
                    |> Parser.keep Parser.getPosition
                    |> Parser.keep (Parser.mapError VariableError Variable.lowerCase)
                    |> Parser.keep Parser.getPosition
                    |> Parser.skip spaceParser
                    |> Parser.andThen
                        (\var ->
                            Parser.oneOf
                                [ Parser.succeed identity
                                    |> Parser.skip (Parser.chompChar '|' (ExpectedChar '|'))
                                    |> Parser.skip spaceParser
                                    |> Parser.keep recordFieldParser
                                    |> Parser.skip spaceParser
                                    |> Parser.andThen
                                        (\firstPair ->
                                            Parser.loop [ firstPair ] innerRecordParser
                                        )
                                    |> Parser.map (\fields -> AST.TRecord { fields = fields, extending = Just var })
                                , Parser.succeed identity
                                    |> Parser.skip (Parser.chompChar ':' (ExpectedChar ':'))
                                    |> Parser.skip spaceParser
                                    |> Parser.keep expression
                                    |> Parser.skip spaceParser
                                    |> Parser.andThen
                                        (\expr ->
                                            Parser.loop [ { field = var, signature = expr } ] innerRecordParser
                                        )
                                    |> Parser.map (\fields -> AST.TRecord { fields = fields, extending = Nothing })
                                ]
                        )
                ]
            )


recordFieldParser : Parser Context Error AST.TRecordField
recordFieldParser =
    Parser.succeed
        (\fieldStart field fieldEnd signature ->
            { field = SourcePosition.at fieldStart fieldEnd field
            , signature = signature
            }
        )
        |> Parser.keep Parser.getPosition
        |> Parser.keep (Parser.mapError VariableError Variable.lowerCase)
        |> Parser.keep Parser.getPosition
        |> Parser.skip spaceParser
        |> Parser.skip (Parser.chompChar ':' (ExpectedChar ':'))
        |> Parser.skip spaceParser
        |> Parser.keep expression


innerRecordParser : Array AST.TRecordField -> Parser Context Error (Parser.Step (Array AST.TRecordField) (Array AST.TRecordField))
innerRecordParser array =
    Parser.oneOf
        [ Parser.chompChar '}' (ExpectedChar '}')
            |> Parser.map (\_ -> Parser.Done array)
        , Parser.succeed (\expr -> Parser.Loop (Array.pushLast expr array))
            |> Parser.skip (Parser.chompChar ',' (ExpectedChar ','))
            |> Parser.skip spaceParser
            |> Parser.keep recordFieldParser
            |> Parser.skip spaceParser
        ]
