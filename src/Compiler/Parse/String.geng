module Compiler.Parse.String exposing
    ( Error (..)
    , char
    , string
    , errorToString
    )


{-| This module provides parsers for Gren string and character literals.

@docs char, string, Error, errorToString
-}


import String.Parser.Advanced as Parser exposing (Parser)
import Compiler.Parse.Number as Number
import Compiler.Parse.Space as Space
import Compiler.Parse.Context exposing (Context)
import Compiler.SourcePosition exposing (Position)


{-| The kind of errors that can happen while parsing characters and strings.
-}
type Error
    = ExpectedQuote
    | ExpectedChar
    | ExpectedEscapeChar String
    | ExpectedUnicodeOpening
    | ExpectedValidUnicode
    | ExpectedUnicodeClosing
    | ExpectedNewline
    | MisalignedMultiQuotes
    | BidiControl Int


{-| Returns a human-readable description of an `Error`.
-}
errorToString : Error -> String
errorToString error =
    when error is
        ExpectedQuote ->
            "Expected quote"
        
        ExpectedChar ->
            "Expected a character"
        
        ExpectedEscapeChar escapeSeq ->
            "Invalid escape sequence: '" ++ escapeSeq ++ "'"
        
        ExpectedUnicodeOpening ->
            "Expected unicode opening 'u{'"
        
        ExpectedValidUnicode ->
            "Invalid unicode value"
        
        ExpectedUnicodeClosing ->
            "Expected unicode closing '}'"
        
        ExpectedNewline ->
            "Expected newline"
        
        MisalignedMultiQuotes ->
            "Multi-line string lines are not indented equally"

        BidiControl code ->
            "A direction control character, "
                ++ Space.codePointName code
                ++ ", is written as itself; if you mean to have it here, write it as \\u{"
                ++ String.dropFirst 2 (Space.codePointName code)
                ++ "}"


{-| Use this to parse character literals.

    String.Parser.run char Compiler.Parse.Context.empty source
-}
char : Parser Context Error Char
char =
    Parser.succeed identity
        |> Parser.skip charQuote
        |> Parser.keep coreParser
        |> Parser.skip charQuote


{-| One character of a literal, decoded. -}
coreParser : Parser Context Error Char
coreParser =
    Parser.oneOf
        [ Parser.chompChar '\\' ExpectedChar
            |> Parser.andThen
                (\_ ->
                    Parser.oneOf
                        [ Parser.chompChar 'n' ExpectedChar
                            |> Parser.map (\_ -> '\n')
                        , Parser.chompChar 'r' ExpectedChar
                            |> Parser.map (\_ -> '\r')
                        , Parser.chompChar 't' ExpectedChar
                            |> Parser.map (\_ -> '\t')
                        , Parser.chompChar '\\' ExpectedChar
                            |> Parser.map (\_ -> '\\')
                        , Parser.chompChar '\'' ExpectedChar
                            |> Parser.map (\_ -> '\'')
                        , Parser.chompChar '\"' ExpectedChar
                            |> Parser.map (\_ -> '\"')
                        , Parser.succeed identity
                            |> Parser.skip unicodeOpening
                            |> Parser.keep (Number.hexParser ExpectedValidUnicode)
                            |> Parser.skip (Parser.chompChar '}' ExpectedUnicodeClosing)
                            |> Parser.andThen
                                (\num ->
                                    -- `Char.fromCode` answers `Nothing` for a
                                    -- number that is not a Unicode scalar
                                    -- value (C8, `m1b-str.md` §T12), which is
                                    -- the question this escape is asking. What
                                    -- was here looked for the replacement
                                    -- character coming back and treated that as
                                    -- the failure -- which no failure produced:
                                    -- a surrogate escape was accepted, and a
                                    -- number past `0x10FFFF` threw a
                                    -- `RangeError` out of the kernel.
                                    when Char.fromCode num is
                                        Nothing ->
                                            Parser.problem ExpectedValidUnicode

                                        Just character ->
                                            Parser.succeed character
                                )
                        , Parser.chompIf (\_ -> True)  ExpectedChar
                            |> Parser.getChompedString
                            |> Parser.andThen (Parser.problem << ExpectedEscapeChar)
                        ]
                )
        , Parser.chompIf (\_ -> True) ExpectedChar
            |> Parser.getChompedString
            |> Parser.andThen
                (\str ->
                    when String.popFirst str is
                        Nothing ->
                            Parser.problem ExpectedChar

                        Just { first = c } ->
                            -- A line break written as itself ends a
                            -- single-line string or a character too early, as
                            -- `gren make` says; a multi-line string reads its
                            -- line breaks before it gets here (geng-lang D602).
                            if c == '\n' then
                                Parser.problem ExpectedQuote

                            else if Space.isBidiControl (Char.toCode c) then
                                -- Written as itself, it reorders how the text
                                -- after it is displayed (geng-lang D604); the
                                -- escape is how to write one.
                                Parser.problem (BidiControl (Char.toCode c))

                            else
                                Parser.succeed c
                )
        ]


charQuote : Parser Context Error {}
charQuote =
    Parser.token "\'" ExpectedQuote


singleLineStrQuote : Parser Context Error {}
singleLineStrQuote =
    Parser.token "\"" ExpectedQuote


multiLineStrQuote : Parser Context Error {}
multiLineStrQuote =
    Parser.token "\"\"\"" ExpectedQuote


unicodeOpening : Parser Context Error {}
unicodeOpening =
    Parser.token "u{" ExpectedUnicodeOpening


crlf : Parser Context Error {}
crlf =
    Parser.token "\r\n" ExpectedNewline


{-| Use this to parse string literals.

    String.Parser.run string Compiler.Parse.Context.empty source
-}
string : Parser Context Error String
string =
    Parser.oneOf
        [ Parser.getPosition
            |> Parser.andThen multiLineString
        , Parser.succeed .str
            |> Parser.skip singleLineStrQuote
            |> Parser.keep (Parser.loop noneRead (innerSingleLineString singleLineStrQuote))
        ]


{-| A string literal's text so far. In a multi-line string, `short` says that
the line being read had fewer spaces than the indentation, which only a blank
line may. -}
type alias Read =
    { str : String, short : Bool }


noneRead : Read
noneRead =
    { str = "", short = False }


{-| A multi-line string whose opening quotes are at `start`, not yet read.

Every line starts with as many spaces as there are columns before the opening
quotes, and they are not part of the string. The closing quotes are in the
opening ones' column, and the string ends with the line break before them
(geng-lang D603). The spaces are counted as the source is read, so an escape is
never indentation and never a line break, and nothing the content ends with is
trimmed.
-}
multiLineString : Position -> Parser Context Error String
multiLineString start =
    let
        indent =
            start.col - 1
    in
    Parser.succeed identity
        |> Parser.skip multiLineStrQuote
        |> Parser.skip
            (Parser.oneOf
                [ Parser.chompChar '\n' ExpectedNewline
                , crlf
                ]
            )
        |> Parser.keep (lineIndentation indent)
        |> Parser.andThen (\short -> Parser.loop { noneRead | short = short } (innerMultiLineString indent))
        |> Parser.andThen
            (\read ->
                Parser.getPosition
                    |> Parser.andThen
                        (\end ->
                            if end.col - 3 /= start.col then
                                Parser.problem MisalignedMultiQuotes

                            else
                                Parser.succeed (dropClosingLine read.str)
                        )
            )


{-| The spaces a line of a multi-line string starts with, up to `indent` of
them, and whether there were fewer. -}
lineIndentation : Int -> Parser Context Error Bool
lineIndentation indent =
    Parser.loop 0
        (\count ->
            if count >= indent then
                Parser.succeed (Parser.Done False)

            else
                Parser.oneOf
                    [ Parser.chompChar ' ' ExpectedChar
                        |> Parser.map (\_ -> Parser.Loop (count + 1))
                    , Parser.succeed (Parser.Done True)
                    ]
        )


{-| The content as read ends with the line break before the closing quotes,
whose line's indentation has been read as indentation. The string is what comes
before that line break. -}
dropClosingLine : String -> String
dropClosingLine str =
    if String.endsWith "\n" str then
        String.dropLast 1 str

    else
        str


innerMultiLineString : Int -> Read -> Parser Context Error (Parser.Step Read Read)
innerMultiLineString indent read =
    let
        nextLine short =
            Parser.Loop { read | str = String.pushLast '\n' read.str, short = short }
    in
    Parser.oneOf
        [ Parser.succeed {}
            |> Parser.skip multiLineStrQuote
            |> Parser.map (\_ -> Parser.Done read)
        , Parser.succeed nextLine
            |> Parser.skip
                (Parser.oneOf
                    [ Parser.chompChar '\n' ExpectedNewline
                    , crlf
                    ]
                )
            |> Parser.keep (lineIndentation indent)
        , coreParser
            |> Parser.andThen
                (\c ->
                    if read.short then
                        Parser.problem MisalignedMultiQuotes

                    else
                        Parser.succeed (Parser.Loop (pushRead c read))
                )
        ]


pushRead : Char -> Read -> Read
pushRead c read =
    { read | str = String.pushLast c read.str }


innerSingleLineString : Parser Context Error {} -> Read -> Parser Context Error (Parser.Step Read Read)
innerSingleLineString endToken read =
    Parser.oneOf
        [ Parser.succeed {}
            |> Parser.skip endToken
            |> Parser.map (\_ -> Parser.Done read)
        , Parser.succeed (\c -> Parser.Loop (pushRead c read))
            |> Parser.keep coreParser
        ]
