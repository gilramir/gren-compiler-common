module Compiler.Parse.String exposing
    ( Error (..)
    , char
    , string
    , errorToString
    )


{-| This module provides parsers for Gren string and character literals.

@docs char, string, Error, errorToString
-}


import String.Parser.Advanced as Parser exposing (Parser)
import Compiler.Parse.Number as Number
import Compiler.Parse.Context exposing (Context)
import Compiler.SourcePosition exposing (Position)
import Array.Builder


{-| The kind of errors that can happen while parsing characters and strings.
-}
type Error
    = ExpectedQuote
    | ExpectedChar
    | ExpectedEscapeChar String
    | ExpectedUnicodeOpening
    | ExpectedValidUnicode
    | ExpectedUnicodeClosing
    | ExpectedNewline
    | MisalignedMultiQuotes


{-| Returns a human-readable description of an `Error`.
-}
errorToString : Error -> String
errorToString error =
    when error is
        ExpectedQuote ->
            "Expected quote"
        
        ExpectedChar ->
            "Expected a character"
        
        ExpectedEscapeChar escapeSeq ->
            "Invalid escape sequence: '" ++ escapeSeq ++ "'"
        
        ExpectedUnicodeOpening ->
            "Expected unicode opening 'u{'"
        
        ExpectedValidUnicode ->
            "Invalid unicode value"
        
        ExpectedUnicodeClosing ->
            "Expected unicode closing '}'"
        
        ExpectedNewline ->
            "Expected newline"
        
        MisalignedMultiQuotes ->
            "Multi-line string lines are not indented equally"


{-| Use this to parse character literals.

    String.Parser.run char Compiler.Parse.Context.empty source
-}
char : Parser Context Error Char
char =
    Parser.succeed (\start c -> { start = start, c = c })
        |> Parser.keep Parser.getPosition
        |> Parser.skip charQuote
        |> Parser.keep coreParser
        |> Parser.skip charQuote
        |> Parser.andThen
            (\{ start, c } ->
                rememberEscapes start
                    (if c.unicode then
                        [ Char.toCode c.char ]

                     else
                        []
                    )
                    c.char
            )


{-| `value`, once the code points a literal starting at `start` spells as
`\u{...}` are recorded in the payload, so that a formatter can spell them the
same way (`Context.escapes`, geng-lang D601). Most literals spell none, and
record nothing.
-}
rememberEscapes : Position -> Array Int -> a -> Parser Context Error a
rememberEscapes start codes value =
    if Array.isEmpty codes then
        Parser.succeed value

    else
        Parser.updatePayload
            (\payload ->
                { payload
                    | escapes = Array.Builder.pushLast { start = start, codes = codes } payload.escapes
                }
            )
            Parser.getPayload
            |> Parser.map (\_ -> value)


{-| One character of a literal, and whether it was spelled `\u{...}`. -}
coreParser : Parser Context Error { char : Char, unicode : Bool }
coreParser =
    Parser.oneOf
        [ Parser.chompChar '\\' ExpectedChar
            |> Parser.andThen
                (\_ ->
                    Parser.oneOf
                        [ Parser.chompChar 'n' ExpectedChar
                            |> Parser.map (\_ -> plain '\n')
                        , Parser.chompChar 'r' ExpectedChar
                            |> Parser.map (\_ -> plain '\r')
                        , Parser.chompChar 't' ExpectedChar
                            |> Parser.map (\_ -> plain '\t')
                        , Parser.chompChar '\\' ExpectedChar
                            |> Parser.map (\_ -> plain '\\')
                        , Parser.chompChar '\'' ExpectedChar
                            |> Parser.map (\_ -> plain '\'')
                        , Parser.chompChar '\"' ExpectedChar
                            |> Parser.map (\_ -> plain '\"')
                        , Parser.succeed identity
                            |> Parser.skip unicodeOpening
                            |> Parser.keep (Number.hexParser ExpectedValidUnicode)
                            |> Parser.skip (Parser.chompChar '}' ExpectedUnicodeClosing)
                            |> Parser.andThen
                                (\num ->
                                    -- `Char.fromCode` answers `Nothing` for a
                                    -- number that is not a Unicode scalar
                                    -- value (C8, `m1b-str.md` §T12), which is
                                    -- the question this escape is asking. What
                                    -- was here looked for the replacement
                                    -- character coming back and treated that as
                                    -- the failure -- which no failure produced:
                                    -- a surrogate escape was accepted, and a
                                    -- number past `0x10FFFF` threw a
                                    -- `RangeError` out of the kernel.
                                    when Char.fromCode num is
                                        Nothing ->
                                            Parser.problem ExpectedValidUnicode

                                        Just character ->
                                            Parser.succeed { char = character, unicode = True }
                                )
                        , Parser.chompIf (\_ -> True)  ExpectedChar
                            |> Parser.getChompedString
                            |> Parser.andThen (Parser.problem << ExpectedEscapeChar)
                        ]
                )
        , Parser.chompIf (\_ -> True) ExpectedChar
            |> Parser.getChompedString
            |> Parser.andThen
                (\str ->
                    when String.popFirst str is
                        Nothing ->
                            Parser.problem ExpectedChar

                        Just { first = c } ->
                            Parser.succeed (plain c)
                )
        ]


plain : Char -> { char : Char, unicode : Bool }
plain c =
    { char = c, unicode = False }


charQuote : Parser Context Error {}
charQuote =
    Parser.token "\'" ExpectedQuote


singleLineStrQuote : Parser Context Error {}
singleLineStrQuote =
    Parser.token "\"" ExpectedQuote


multiLineStrQuote : Parser Context Error {}
multiLineStrQuote =
    Parser.token "\"\"\"" ExpectedQuote


unicodeOpening : Parser Context Error {}
unicodeOpening =
    Parser.token "u{" ExpectedUnicodeOpening


crlf : Parser Context Error {}
crlf =
    Parser.token "\r\n" ExpectedNewline


{-| Use this to parse string literals.

    String.Parser.run string Compiler.Parse.Context.empty source
-}
string : Parser Context Error String
string =
    Parser.oneOf
        [ Parser.succeed
            (\startPos read endPos ->
                { start = startPos
                , str = String.trimRight read.str
                , codes = read.codes
                , end = endPos
                }
            )
            |> Parser.keep Parser.getPosition
            |> Parser.skip multiLineStrQuote
            |> Parser.skip
                (Parser.oneOf
                    [ Parser.chompChar '\n' ExpectedNewline
                    , crlf
                    ]
                )
            |> Parser.keep (Parser.loop noneRead (innerSingleLineString multiLineStrQuote))
            |> Parser.keep Parser.getPosition
            |> Parser.andThen
                (\{ start, str, codes, end } ->
                    if end.col - 3 /= start.col then
                        Parser.problem MisalignedMultiQuotes

                    else
                        let
                            requiredIndent =
                                start.col - 1

                            lines =
                                String.split "\n" str

                            linesSufficientlyIndented =
                                lines
                                    |> Array.all
                                        (\line ->
                                            if String.isEmpty line then
                                                True

                                            else
                                                let
                                                    whiteSpacePortion =
                                                        String.takeFirst requiredIndent line
                                                in
                                                String.count whiteSpacePortion <= requiredIndent
                                                    && String.all (\c -> c == ' ') whiteSpacePortion
                                        )
                        in
                        if linesSufficientlyIndented then
                            lines
                                |> Array.map (String.dropFirst requiredIndent) 
                                |> String.join "\n"
                                |> rememberEscapes start codes

                        else
                            Parser.problem MisalignedMultiQuotes
                )
        , Parser.succeed (\start read -> { start = start, read = read })
            |> Parser.keep Parser.getPosition
            |> Parser.skip singleLineStrQuote
            |> Parser.keep (Parser.loop noneRead (innerSingleLineString singleLineStrQuote))
            |> Parser.andThen (\{ start, read } -> rememberEscapes start read.codes read.str)
        ]


{-| A string literal's text so far, and the code points it has spelled as
`\u{...}`, each once. -}
type alias Read =
    { str : String, codes : Array Int }


noneRead : Read
noneRead =
    { str = "", codes = [] }


innerSingleLineString : Parser Context Error {} -> Read -> Parser Context Error (Parser.Step Read Read)
innerSingleLineString endToken read =
    Parser.oneOf
        [ Parser.succeed {}
            |> Parser.skip endToken
            |> Parser.map (\_ -> Parser.Done read)
        , Parser.succeed (\_ -> Parser.Loop { read | str = String.pushLast '\n' read.str })
            |> Parser.keep crlf
        , Parser.succeed
            (\c ->
                Parser.Loop
                    { str = String.pushLast c.char read.str
                    , codes =
                        if c.unicode && not (Array.member (Char.toCode c.char) read.codes) then
                            Array.pushLast (Char.toCode c.char) read.codes

                        else
                            read.codes
                    }
            )
            |> Parser.keep coreParser
        ]
