module Compiler.Parse.Variable exposing
    ( Error (..)
    , lowerCase
    , upperCase
    , ForeignVar (..)
    , foreignVarToString
    , foreignUpper
    , foreignVar
    , reservedWords
    , keyword
    , errorToString
    )


{-| This module provides parsers for Gren variables and identifiers.

@docs lowerCase, reservedWords, upperCase, foreignUpper, foreignVar, ForeignVar, foreignVarToString

## Keywords

@docs keyword

## Errors

@docs Error, errorToString
-}


import String.Parser.Advanced as Parser exposing (Parser)
import Compiler.Parse.Letters as Letters
import Set exposing (Set)
import Compiler.Parse.Context exposing (Context)


{-| The kind of errors that can happen while parsing variables.
-}
type Error
    = InvalidCharacter
    | ExpectedDot
    | ReservedWord String


{-| Returns a human-readable description of an `Error`.
-}
errorToString : Error -> String
errorToString error =
    when error is
        InvalidCharacter ->
            "Invalid character in variable name"
        
        ExpectedDot ->
            "Expected '.' character"
        
        ReservedWord word ->
            "Reserved word used as variable: '" ++ word ++ "'"


{-| Use this to parse lowercase variable names. It will fail if the variable
is one of the reserved words.

    String.Parser.run lowerCase Compiler.Parse.Context.empty source
-}
lowerCase : Parser Context Error String
lowerCase =
    -- TODO: simply stops parsing at invalid character, in lack of better alternatives
    -- Revisit this once gren-lang/parser has gotten more flexible
    Parser.succeed {}
        |> Parser.skip (Parser.chompIf isLowerCaseLetter InvalidCharacter)
        |> Parser.skip (Parser.chompWhile isInner)
        |> Parser.getChompedString
        |> Parser.andThen
            (\word ->
                if Set.member word reservedWords then
                    Parser.problem (ReservedWord word)

                else
                    Parser.succeed word
            )
        -- TODO: uncertain if this `backtrackable` work the way I intend
        -- ideally, we'd only backtrack on reserved words
        |> Parser.backtrackable


{-| Words which successfully parses as variables, but which are reserved by the
language spec. This includes words like `if`, `when`, `import` etc.
-}
reservedWords : Set String
reservedWords =
    Set.fromArray
        [ "if"
        , "then"
        , "else"
        , "when"
        , "is"
        , "let"
        , "in"
        , "type"
        , "module"
        , "where"
        , "import"
        , "exposing"
        , "as"
        , "port"
        ]


{-| Use this to parse uppercase variable names (like type constructors).

    String.Parser.run upperCase Compiler.Parse.Context.empty source
-}
upperCase : Parser Context Error String
upperCase =
    Parser.succeed {}
        |> Parser.skip (Parser.chompIf isUpperCaseLetter InvalidCharacter)
        |> Parser.skip (Parser.chompWhile isInner)
        |> Parser.getChompedString


{-| The result of using a `foreign*` parser. Sometimes you will get an actual
foreign (qualified) var. Sometimes you just get an upper-case identifier.
-}
type ForeignVar
    = Unqualified String
    | Qualified { module_ : String, name : String }


{-| Convert a foreign variable to its string representation.
-}
foreignVarToString : ForeignVar -> String
foreignVarToString fv =
    when fv is
        Unqualified str ->
            str

        Qualified { module_, name } ->
            module_ ++ "." ++ name


{-| Use this to parse foreign uppercase variables (like `Maybe.Just`).

    String.Parser.run foreignUpper Compiler.Parse.Context.empty source
-}
foreignUpper : Parser Context Error ForeignVar
foreignUpper =
    upperCase
        |> Parser.andThen
            (\first ->
                Parser.loop { module_ = [], name = first } foreignUpperLoop
                    |> Parser.map
                        (\{ module_, name } ->
                            when module_ is
                                [] ->
                                    Unqualified name

                                _ ->
                                    Qualified
                                        { module_ = String.join "." module_
                                        , name = name
                                        }
                        )
            )


type alias ForeignVarStep =
    { module_ : Array String
    , name : String
    }


foreignUpperLoop : ForeignVarStep -> Parser Context Error (Parser.Step ForeignVarStep ForeignVarStep)
foreignUpperLoop acc =
    Parser.oneOf
        [ Parser.succeed
            (\next ->
                Parser.Loop { module_ = Array.pushLast acc.name acc.module_, name = next }
            )
            |> Parser.skip (Parser.chompChar '.' ExpectedDot)
            |> Parser.keep upperCase
        , Parser.succeed (Parser.Done acc)
        ]


{-| Use this to parse foreign variables (like `List.map` or `Maybe.Just`).

    String.Parser.run foreignVar Compiler.Parse.Context.empty source
-}
foreignVar : Parser Context Error ForeignVar
foreignVar =
    upperCase
        |> Parser.andThen
            (\first ->
                Parser.loop { module_ = [], name = first } foreignVarLoop
                    |> Parser.map
                        (\{ module_, name } ->
                            when module_ is
                                [] ->
                                    Unqualified name

                                _ ->
                                    Qualified
                                        { module_ = String.join "." module_
                                        , name = name
                                        }
                        )
            )


foreignVarLoop : ForeignVarStep -> Parser Context Error (Parser.Step ForeignVarStep ForeignVarStep)
foreignVarLoop acc =
    Parser.oneOf
        [ Parser.succeed identity
            |> Parser.skip (Parser.chompChar '.' ExpectedDot)
            |> Parser.keep
                (Parser.oneOf
                    [ Parser.succeed
                        (\next ->
                            Parser.Loop { module_ = Array.pushLast acc.name acc.module_, name = next }
                        )
                        |> Parser.keep upperCase
                    , Parser.succeed
                        (\varName ->
                            Parser.Done { module_ = Array.pushLast acc.name acc.module_, name = varName }
                        )
                        |> Parser.keep lowerCase
                    ]
                )
        , Parser.succeed (Parser.Done acc)
        ]


{-| May this character start a lower-case name? A lowercase letter,
general category `Ll`.
-}
isLowerCaseLetter : Char -> Bool
isLowerCaseLetter char =
    Char.isLower char || letterClass char == Letters.lower


{-| May this character start an upper-case name? An uppercase or titlecase
letter, general category `Lu` or `Lt` — titlecase because `ǅ` is where a
capitalised word that starts with that digraph begins.
-}
isUpperCaseLetter : Char -> Bool
isUpperCaseLetter char =
    Char.isUpper char || letterClass char == Letters.upper


{-| Which of `Compiler.Parse.Letters`' classes a character above ASCII is in,
or `0` if it is not a letter. Below 128 this is always `0`: the callers ask
`Char.isLower`, `Char.isUpper` and `Char.isAlphaNum` first, and the generator
refuses a database in which the ASCII letters are anything but `A`-`Z` and
`a`-`z`.

These were `\p{Ll}` and `\p{Lu}` regexes, which asked the host's Unicode
version and left out titlecase, modifier and "other" letters that the Haskell
frontend accepts (`docs/m1b-str.md` §T23).
-}
letterClass : Char -> Int
letterClass char =
    let
        code =
            Char.toCode char
    in
    if code < 128 then
        0

    else
        searchLetters code 0 (Array.length Letters.ranges // 3 - 1)


searchLetters : Int -> Int -> Int -> Int
searchLetters code low high =
    if low > high then
        0

    else
        let
            mid =
                low + (high - low) // 2
        in
        when Array.get (mid * 3) Letters.ranges is
            Just lo ->
                if code < lo then
                    searchLetters code low (mid - 1)

                else
                    when Array.get (mid * 3 + 1) Letters.ranges is
                        Just hi ->
                            if code > hi then
                                searchLetters code (mid + 1) high

                            else
                                Array.get (mid * 3 + 2) Letters.ranges
                                    |> Maybe.withDefault 0

                        Nothing ->
                            0

            Nothing ->
                0


isInner : Char -> Bool
isInner char =
    Char.isAlphaNum char
        || char == '_'
        || letterClass char /= 0


{-| Parse a keyword, and require that the source does not simply continue into
a longer name: `type` in `typeOf` is not the keyword.

`String.Parser.Advanced.keyword` already does that, but it decides where a word
ends with `Char.isAlphaNum`, which is ASCII by contract and is not what a Gren
identifier is. Every non-ASCII letter therefore looked like the end of the
keyword, and `typeé`, `typeｚ` and `type𝐚` were each split into a keyword and a
remainder that then failed to parse — while the reference compiler accepts all
three. The predicate is not a parameter of that function, so a caller whose
identifiers reach past ASCII has to bring its own; this is it, over the same
`isInner` that `lowerCase` and `upperCase` chomp with.

    String.Parser.run (keyword "type" Nope) Compiler.Parse.Context.empty source
-}
keyword : String -> x -> Parser Context x {}
keyword kwd expecting =
    Parser.succeed (\continues -> continues)
        |> Parser.skip (Parser.backtrackable (Parser.token kwd expecting))
        |> Parser.keep
            (Parser.oneOf
                [ Parser.backtrackable (Parser.chompIf isInner expecting)
                    |> Parser.map (\_ -> True)
                , Parser.succeed False
                ]
            )
        |> Parser.andThen
            (\continues ->
                if continues then
                    Parser.problem expecting

                else
                    Parser.commit {}
            )
