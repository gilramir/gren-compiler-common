module Compiler.Parse.Context exposing
    ( Context
    --
    , empty
    , Comment (..)
    )


{-| This module defines the data which can be inferred
from a Gren source file during parsing, but which won't end up
in the resulting AST. This includes the current indentation
level while parsing, and the comments picked up along the way.

The reason we store comments is that they're useful when formatting
or generating code.

@docs Context, empty, Comment

-}

import Dict exposing (Dict)
import Array.Builder exposing (Builder)
import Compiler.SourcePosition as SourcePosition


{-| The "hidden" state of a parser when parsing Gren code.

* `indent` - the current indentation level
* `lineStart` - the first non-whitespace character on the current line
* `comments` - comments we've parsed from the source code
* `escapes` - for each string or character literal that spells a code point
  as `\u{...}`, where the literal starts and the code points it spells that
  way, so that a formatter can keep the author's escapes (geng-lang D601)
-}
type alias Context =
    { indent : Int
    , lineStart : Int
    , comments : Builder (SourcePosition.Located Comment)
    , escapes : Builder { start : SourcePosition.Position, codes : Array Int }
    }


{-| The initial `Context`. Use this to start parsing.
-}
empty : Context
empty =
    { indent = 1
    , lineStart = 1
    , comments = Array.Builder.empty 0
    , escapes = Array.Builder.empty 0
    }


{-| There are two types of comments. Line- and block-comments.
-}
type Comment
    = Line String
    | Block String
