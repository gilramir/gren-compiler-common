module Test.Compiler.Parse.Pattern exposing ( tests )

import Test.Compiler.Parse.Run as Run
import Expect exposing (Expectation)
import Test exposing (Test, describe, test, fuzz)
import Fuzz exposing (Fuzzer)
import String.Parser.Advanced as Parser
import Compiler.Parse.Pattern as PT
import Compiler.Ast.Source as AST
import Compiler.SourcePosition as SourcePosition
import Compiler.Parse.Context as Context


tests : Test
tests =
    describe "Parse.Pattern"
        [ test "vars" <| \_ ->
            Run.run PT.parser Context.empty "var"
                |> expectPattern (AST.PVar "var")
        , test "wildcard" <| \_ ->
            Run.run PT.parser Context.empty "_"
                |> expectPattern (AST.PAnything "")
        , test "wildcard (named)" <| \_ ->
            Run.run PT.parser Context.empty "_test"
                |> expectPattern (AST.PAnything "test")
        , test "constructor (unqualified)" <| \_ ->
            Run.run PT.parser Context.empty "Ctor"
                |> expectPattern
                    (AST.PCtor
                        { arg = Nothing
                        , name =
                            SourcePosition.at
                                { row = 1, col = 1 }
                                { row = 1, col = 5 }
                                "Ctor"
                        }
                    )
        , test "constructor (qualified)" <| \_ ->
            Run.run PT.parser Context.empty "My.Ctor"
                |> expectPattern
                    (AST.PCtorQual
                        { varRegion =
                            { start = { row = 1, col = 1 }
                            , end = { row = 1, col = 8 }
                            }
                        , arg = Nothing
                        , module_ = "My"
                        , name = "Ctor"
                        }
                    )
        , test "constructor with args requires parens" <| \_ ->
            Run.run PT.parser Context.empty "Ctor arg"
                |> expectPattern
                    (AST.PCtor
                        { arg = Nothing
                        , name =
                            SourcePosition.at
                                { row = 1, col = 1 }
                                { row = 1, col = 5 }
                                "Ctor"
                        }
                    )
        , test "constructor (with arg)" <| \_ ->
            Run.run PT.parser Context.empty "(Ctor arg)"
                |> expectPattern
                    (AST.PCtor
                        { arg =
                            Just <|
                                SourcePosition.at
                                    { row = 1, col = 7 }
                                    { row = 1, col = 10 }
                                    (AST.PVar "arg")
                        , name =
                            SourcePosition.at
                                { row = 1, col = 2 }
                                { row = 1, col = 6 }
                                "Ctor"
                        }
                    )
        , test "constructor (with arg and whitespace)" <| \_ ->
            Run.run PT.parser Context.empty "( Ctor arg )"
                |> expectPattern
                    (AST.PCtor
                        { arg =
                            Just <|
                                SourcePosition.at
                                    { row = 1, col = 8 }
                                    { row = 1, col = 11 }
                                    (AST.PVar "arg")
                        , name =
                            SourcePosition.at
                                { row = 1, col = 3 }
                                { row = 1, col = 7 }
                                "Ctor"
                        }
                    )
        , test "constructor (with args and alias)" <| \_ ->
            Run.run PT.parser Context.empty "(Ctor arg) as myVar"
                |> expectPattern
                    (AST.PAlias
                        { pattern =
                            SourcePosition.at
                                { row = 1, col = 2 }
                                { row = 1, col = 10 }
                                ( AST.PCtor
                                    { arg =
                                        Just <|
                                            SourcePosition.at
                                                { row = 1, col = 7 }
                                                { row = 1, col = 10 }
                                                (AST.PVar "arg")
                                    , name =
                                        SourcePosition.at
                                            { row = 1, col = 2 }
                                            { row = 1, col = 6 }
                                            "Ctor"
                                    }
                                )
                        , name =
                            SourcePosition.at
                                { row = 1, col = 15 }
                                { row = 1, col = 20 }
                                "myVar"
                        }
                    )
        , test "ints" <| \_ ->
            Run.run PT.parser Context.empty "160"
                |> expectPattern
                    (AST.PInt { isHex = False, text = "160" })
        , test "a negative int is refused, as the Haskell parser refuses it (D86; m1b-int.md I20)" <| \_ ->
            Run.run PT.parser Context.empty "(-10)"
                |> Expect.err
        , test "ints (hex)" <| \_ ->
            Run.run PT.parser Context.empty "0xAB"
                |> expectPattern
                    (AST.PInt { isHex = True, text = "0xAB" })
        , test "string" <| \_ ->
            Run.run PT.parser Context.empty "\"some String\""
                |> expectPattern
                    (AST.PStr "some String")
        , test "char" <| \_ ->
            Run.run PT.parser Context.empty "'z'"
                |> expectPattern
                    (AST.PChr 'z')
        , test "array (empty)" <| \_ ->
            Run.run PT.parser Context.empty "[]"
                |> expectPattern
                    (AST.PArray [])
        , test "array" <| \_ ->
            Run.run PT.parser Context.empty "[ a, 2, b ]"
                |> expectPattern
                    (AST.PArray
                        [ SourcePosition.at
                            { row = 1, col = 3 }
                            { row = 1, col = 4 }
                            (AST.PVar "a")
                        , SourcePosition.at
                            { row = 1, col = 6 }
                            { row = 1, col = 7 }
                            (AST.PInt { isHex = False, text = "2" })
                        , SourcePosition.at
                            { row = 1, col = 9 }
                            { row = 1, col = 10 }
                            (AST.PVar "b")
                        ]
                    )
        , test "array with constructor" <| \_ ->
            Run.run PT.parser Context.empty "[ Nothing, Just 1 ]"
                |> expectPattern
                    (AST.PArray
                        [ SourcePosition.at
                            { row = 1, col = 3 }
                            { row = 1, col = 10 }
                            (AST.PCtor
                                { arg = Nothing
                                , name =
                                    SourcePosition.at
                                        { row = 1, col = 3 }
                                        { row = 1, col = 10 }
                                        "Nothing"
                                }
                            )
                        , SourcePosition.at
                            { row = 1, col = 12 }
                            { row = 1, col = 18 }
                            (AST.PCtor
                                { arg =
                                    Just <|
                                        SourcePosition.at
                                            { row = 1, col = 17 }
                                            { row = 1, col = 18 }
                                            (AST.PInt { isHex = False, text = "1" })
                                , name =
                                    SourcePosition.at
                                        { row = 1, col = 12 }
                                        { row = 1, col = 16 }
                                        "Just"
                                }
                            )
                        ]
                    )
        , test "record (empty)" <| \_ ->
            Run.run PT.parser Context.empty "{}"
                |> expectPattern
                    (AST.PRecord [])
        , test "record" <| \_ ->
            Run.run PT.parser Context.empty "{ a = 1, b = _ }"
                |> expectPattern
                    (AST.PRecord
                        [ { field =
                               SourcePosition.at
                                   { row = 1, col = 3 }
                                   { row = 1, col = 4 }
                                   "a"
                           , pattern =
                               Just <|
                                   SourcePosition.at
                                       { row = 1, col = 7 }
                                       { row = 1, col = 8 }
                                       (AST.PInt { isHex = False, text = "1" })
                           }
                        , { field =
                               SourcePosition.at
                                   { row = 1, col = 10 }
                                   { row = 1, col = 11 }
                                   "b"
                           , pattern =
                               Just <|
                                   SourcePosition.at
                                       { row = 1, col = 14 }
                                       { row = 1, col = 15 }
                                       (AST.PAnything "")
                           }
                        ]
                    )
        , test "record with ctor" <| \_ ->
            Run.run PT.parser Context.empty "{ a = Nothing, b = Just 1 }"
                |> expectPattern
                    (AST.PRecord
                        [ { field =
                               SourcePosition.at
                                   { row = 1, col = 3 }
                                   { row = 1, col = 4 }
                                   "a"
                           , pattern =
                               Just <|
                                   SourcePosition.at
                                       { row = 1, col = 7 }
                                       { row = 1, col = 14 }
                                        (AST.PCtor
                                            { arg = Nothing
                                            , name =
                                                SourcePosition.at
                                                    { row = 1, col = 7 }
                                                    { row = 1, col = 14 }
                                                    "Nothing"
                                            }
                                        )
                           }
                        , { field =
                               SourcePosition.at
                                   { row = 1, col = 16 }
                                   { row = 1, col = 17 }
                                   "b"
                           , pattern =
                               Just <|
                                   SourcePosition.at
                                       { row = 1, col = 20 }
                                       { row = 1, col = 26 }
                                        (AST.PCtor
                                            { arg =
                                                Just <|
                                                    SourcePosition.at
                                                        { row = 1, col = 25 }
                                                        { row = 1, col = 26 }
                                                        (AST.PInt { isHex = False, text = "1" })
                                            , name =
                                                SourcePosition.at
                                                    { row = 1, col = 20 }
                                                    { row = 1, col = 24 }
                                                    "Just"
                                            }
                                        )
                           }
                        ]
                    )
        , test "record (shorthand)" <| \_ ->
            Run.run PT.parser Context.empty "{ a, b = _ }"
                |> expectPattern
                    (AST.PRecord
                        [ { field =
                               SourcePosition.at
                                   { row = 1, col = 3 }
                                   { row = 1, col = 4 }
                                   "a"
                           , pattern =
                                Nothing
                           }
                        , { field =
                               SourcePosition.at
                                   { row = 1, col = 6 }
                                   { row = 1, col = 7 }
                                   "b"
                           , pattern =
                               Just <|
                                   SourcePosition.at
                                       { row = 1, col = 10 }
                                       { row = 1, col = 11 }
                                       (AST.PAnything "")
                           }
                        ]
                    )
        , test "constructor (with array argument)" <| \_ ->
            Run.run PT.parser Context.empty "(MyArray [ one ])"
                |> expectPattern
                    (AST.PCtor
                        { arg =
                            Just <|
                                SourcePosition.at
                                    { row = 1, col = 10 }
                                    { row = 1, col = 17 }
                                    (AST.PArray
                                        [ SourcePosition.at
                                            { row = 1, col = 12 }
                                            { row = 1, col = 15 }
                                            (AST.PVar "one")
                                        ]
                                    )
                        , name =
                            SourcePosition.at
                                { row = 1, col = 2 }
                                { row = 1, col = 9 }
                                "MyArray"
                        }
                    )
        , test "constructor (with record argument)" <| \_ ->
            Run.run PT.parser Context.empty "(MyRecord { x = 1 })"
                |> expectPattern
                    (AST.PCtor
                        { arg =
                            Just <|
                                SourcePosition.at
                                    { row = 1, col = 11 }
                                    { row = 1, col = 20 }
                                    (AST.PRecord
                                        [ { field =
                                               SourcePosition.at
                                                   { row = 1, col = 13 }
                                                   { row = 1, col = 14 }
                                                   "x"
                                           , pattern =
                                               Just <|
                                                   SourcePosition.at
                                                       { row = 1, col = 17 }
                                                       { row = 1, col = 18 }
                                                       (AST.PInt { isHex = False, text = "1" })
                                           }
                                        ]
                                    )
                        , name =
                            SourcePosition.at
                                { row = 1, col = 2 }
                                { row = 1, col = 10 }
                                "MyRecord"
                        }
                    )
        , describe "as"
            [ test "an alias whose name merely starts with `as`" <| \_ ->
                -- The alias suffix used to be `token "as"`, which matches the
                -- first two characters of `as_` and then fails on the `_`. The
                -- same name parses when it is not preceded by a pattern, so a
                -- variable called `as_` was legal as a function's first
                -- argument and rejected as its second.
                Run.run PT.parser Context.empty "x as_"
                    |> expectPattern (AST.PVar "x")
            , test "a constructor pattern with an argument can be aliased" <| \_ ->
                -- `topLevelParser` is the only pattern parser that accepts an
                -- unparenthesized constructor argument, and it had no alias
                -- suffix of its own — so `Just y as whole` parsed as far as
                -- `Just y` and the `when` branch then demanded its `->`.
                Run.run PT.topLevelParser Context.empty "Just y as whole"
                    |> expectPattern
                        (AST.PAlias
                            { pattern =
                                SourcePosition.at
                                    { row = 1, col = 1 }
                                    { row = 1, col = 7 }
                                    (AST.PCtor
                                        { arg =
                                            Just <|
                                                SourcePosition.at
                                                    { row = 1, col = 6 }
                                                    { row = 1, col = 7 }
                                                    (AST.PVar "y")
                                        , name =
                                            SourcePosition.at
                                                { row = 1, col = 1 }
                                                { row = 1, col = 5 }
                                                "Just"
                                        }
                                    )
                            , name =
                                SourcePosition.at
                                    { row = 1, col = 11 }
                                    { row = 1, col = 16 }
                                    "whole"
                            }
                        )
            , test "a bare constructor pattern can be aliased" <| \_ ->
                Run.run PT.topLevelParser Context.empty "Nothing as whole"
                    |> expectPattern
                        (AST.PAlias
                            { pattern =
                                SourcePosition.at
                                    { row = 1, col = 1 }
                                    { row = 1, col = 8 }
                                    (AST.PCtor
                                        { arg = Nothing
                                        , name =
                                            SourcePosition.at
                                                { row = 1, col = 1 }
                                                { row = 1, col = 8 }
                                                "Nothing"
                                        }
                                    )
                            , name =
                                SourcePosition.at
                                    { row = 1, col = 12 }
                                    { row = 1, col = 17 }
                                    "whole"
                            }
                        )
            , test "an alias is still optional after a constructor pattern" <| \_ ->
                Run.run PT.topLevelParser Context.empty "Just y"
                    |> expectPattern
                        (AST.PCtor
                            { arg =
                                Just <|
                                    SourcePosition.at
                                        { row = 1, col = 6 }
                                        { row = 1, col = 7 }
                                        (AST.PVar "y")
                            , name =
                                SourcePosition.at
                                    { row = 1, col = 1 }
                                    { row = 1, col = 5 }
                                    "Just"
                            }
                        )
            ]
        ]


expectPattern : (Eq a, Inspect a, Inspect e) => a -> Result (Array (Run.DeadEnd e)) (SourcePosition.Located a) -> Expectation
expectPattern expected result =
    when result is
        Err err ->
            Expect.fail (inspect err)

        Ok { value } ->
            Expect.equal expected value


expectErr : PT.Error -> Result (Array (Run.DeadEnd PT.Error)) a -> Expectation
expectErr expected result =
    when result is
        Ok _ ->
            Expect.fail "Expected error"

        Err problems ->
            when Array.first problems is
                Just firstProblem ->
                    Expect.equal expected firstProblem.problem

                Nothing ->
                    Expect.fail "Failed, but with no problems..."
