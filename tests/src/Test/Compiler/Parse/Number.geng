module Test.Compiler.Parse.Number exposing ( tests )

import Test.Compiler.Parse.Run as Run
import Expect exposing (Expectation)
import Test exposing (Test, describe, test, fuzz)
import Fuzz exposing (Fuzzer)
import String.Parser.Advanced as Parser
import Compiler.Parse.Number as PN
import Compiler.Parse.Context as Context exposing (Context)


tests : Test
tests =
    describe "Parse.Number"
        [ describe "Integers"
            [ fuzz Fuzz.int "Can parse regular integers" <| \int ->
                run (String.fromInt int)
                    |> Expect.equal (Ok (PN.Integer { text = String.fromInt int, suffix = Nothing }))
            , test "empty string fails" <| \{} ->
                run ""
                    |> expectErr PN.NotANumber
            , test "leading 0 fails" <| \{} ->
                run "012"
                    |> expectErr PN.LeadingZero
            , test "leading negative 0 fails" <| \{} ->
                run "-012"
                    |> expectErr PN.LeadingZero
            , test "when followed by letter, it fails" <| \{} ->
                run "123a"
                    |> expectErr PN.NotANumber
            ]
        , describe "Floats"
            [ fuzz (Fuzz.floatRange 0 32000) "Can parse regular floats" <| \float ->
                run (String.fromFloat float)
                    |> Result.map
                        (\outcome ->
                            when outcome is
                                PN.Integer { text } ->
                                    PN.FloatingPoint { val = String.toFloat text |> Maybe.withDefault -1, text = text, suffix = Nothing }

                                _ ->
                                    outcome
                        )
                    |> Expect.equal (Ok (PN.FloatingPoint { val = float, text = String.fromFloat float, suffix = Nothing }))
            , test "Requires a number after ." <| \{} ->
                run "0."
                    |> expectErr PN.ExpectedInt
            , test "when followed by letter, it fails" <| \{} ->
                run "0.15a"
                    |> expectErr PN.NotANumber
            ]
        , describe "Scientific notation"
            [ test "integer with exponent" <| \{} ->
                run "1e5"
                    |> Expect.equal (Ok (PN.FloatingPoint { val = 1.0e5, text = "1e5", suffix = Nothing }))
            , test "zero with exponent" <| \{} ->
                run "0e3"
                    |> Expect.equal (Ok (PN.FloatingPoint { val = 0.0e3, text = "0e3", suffix = Nothing }))
            , test "decimal with exponent" <| \{} ->
                run "1.5e3"
                    |> Expect.equal (Ok (PN.FloatingPoint { val = 1.5e3, text = "1.5e3", suffix = Nothing }))
            , test "uppercase E" <| \{} ->
                run "1.5E3"
                    |> Expect.equal (Ok (PN.FloatingPoint { val = 1.5e3, text = "1.5E3", suffix = Nothing }))
            , test "explicit positive exponent" <| \{} ->
                run "1.5e+3"
                    |> Expect.equal (Ok (PN.FloatingPoint { val = 1.5e3, text = "1.5e+3", suffix = Nothing }))
            , test "negative exponent" <| \{} ->
                run "1.5e-3"
                    |> Expect.equal (Ok (PN.FloatingPoint { val = 1.5e-3, text = "1.5e-3", suffix = Nothing }))
            , test "negative number with exponent" <| \{} ->
                run "-1.5e3"
                    |> Expect.equal (Ok (PN.FloatingPoint { val = -1.5e3, text = "-1.5e3", suffix = Nothing }))
            , test "requires digits after e" <| \{} ->
                run "1e"
                    |> expectErr PN.ExpectedInt
            , test "requires digits after e sign" <| \{} ->
                run "1e+"
                    |> expectErr PN.ExpectedInt
            ]
        , describe "Hex"
            [ test "Can parse hex" <| \{} ->
                run "0xAFFE"
                    |> Expect.equal (Ok (PN.Hex { text = "0xAFFE", suffix = Nothing }))
            , test "Requires a hex digit after 0x" <| \{} ->
                run "0x"
                    |> expectErr PN.ExpectedHex
            , test "When followed by illegal character, it fails" <| \{} ->
                run "0xABZ"
                    |> expectErr PN.NotANumber
            , test "a hex literal is its text, sign included" <| \{} ->
                run "-0x1FFFFFFFFFFFCA"
                    |> Expect.equal (Ok (PN.Hex { text = "-0x1FFFFFFFFFFFCA", suffix = Nothing }))
            , describe "hexParser"
                -- A hex *literal* comes back as text (D149's reason), and the
                -- number is the frontend's to make. `hexParser` still folds the
                -- digits into an Int, for a `\u{...}` escape.
                [ hex "0" 0
                , hex "ff" 255
                , hex "FF" 255
                , hex "7FFFFFFF" 2147483647
                , hex "10FFFF" 1114111
                ]
            ]
        , describe "Suffixes"
            -- docs/syntax.md S5, D154; the narrow four are D342's (D348).
            [ suffixed "42i64" "42" PN.I64
            , suffixed "42u32" "42" PN.U32
            , suffixed "42u64" "42" PN.U64
            , suffixed "42i8" "42" PN.I8
            , suffixed "42u8" "42" PN.U8
            , suffixed "42i16" "42" PN.I16
            , suffixed "42u16" "42" PN.U16
            , test "a float with f32" <| \{} ->
                run "1.5f32"
                    |> Expect.equal (Ok (PN.FloatingPoint { val = 1.5, text = "1.5", suffix = Just PN.F32 }))
            , test "a negative literal keeps its suffix" <| \{} ->
                run "-7i8"
                    |> Expect.equal (Ok (PN.Integer { text = "-7", suffix = Just PN.I8 }))
            , test "every suffix on every literal; the frontend refuses 1.5i64" <| \{} ->
                run "1.5i64"
                    |> Expect.equal (Ok (PN.FloatingPoint { val = 1.5, text = "1.5", suffix = Just PN.I64 }))
            , test "a hex literal takes an integer suffix" <| \{} ->
                run "0xFFu8"
                    |> Expect.equal (Ok (PN.Hex { text = "0xFF", suffix = Just PN.U8 }))
            , test "f32 on hex is three more hex digits" <| \{} ->
                run "0xFFf32"
                    |> Expect.equal (Ok (PN.Hex { text = "0xFFf32", suffix = Nothing }))
            , test "a digit after a suffix is refused, not read as a second number (m1b-narrow-int.md NI2.5)" <| \{} ->
                run "42i640"
                    |> expectErr PN.NotANumber
            , test "an unknown suffix is refused" <| \{} ->
                run "42i32"
                    |> expectErr PN.NotANumber
            , test "an underscore after a number is refused" <| \{} ->
                run "42_"
                    |> expectErr PN.NotANumber
            , test "suffixToString writes the suffix as it is written" <| \{} ->
                [ PN.I64, PN.U32, PN.U64, PN.F32, PN.I8, PN.U8, PN.I16, PN.U16 ]
                    |> Array.map PN.suffixToString
                    |> Expect.equal [ "i64", "u32", "u64", "f32", "i8", "u8", "i16", "u16" ]
            ]
        ]


suffixed : String -> String -> PN.Suffix -> Test
suffixed source text suffix =
    test ("reads " ++ source) <| \{} ->
        run source
            |> Expect.equal (Ok (PN.Integer { text = text, suffix = Just suffix }))


hex : String -> Int -> Test
hex digits value =
    test ("0x" ++ digits) <| \{} ->
        Run.run (PN.hexParser PN.ExpectedHex) Context.empty digits
            |> Expect.equal (Ok value)


run : String -> Result (Array (Run.DeadEnd PN.Error)) PN.Outcome
run str =
    Run.run PN.parser Context.empty str


expectErr : PN.Error -> Result (Array (Run.DeadEnd PN.Error)) PN.Outcome -> Expectation
expectErr expected result =
    when result is
        Ok _ ->
            Expect.fail "Expected error"

        Err problems ->
            when Array.first problems is
                Just firstProblem ->
                    Expect.equal expected firstProblem.problem

                Nothing ->
                    Expect.fail "Failed, but with no problems..."
