module Test.Compiler.Parse.Run exposing (DeadEnd, run)

{-| `Parser.run` without the payload at each dead end.

Each dead end carries the parser's `Context` at that point, comments and all.
What a test asks about a failure is where it was and what the problem is. (The
comments were an `Array.Builder`, which has no `Eq` or `Inspect` instance, until
geng-lang D927.)
-}

import String.Parser.Advanced as Parser exposing (Parser)


type alias DeadEnd problem =
    { row : Int
    , col : Int
    , problem : problem
    }


run : Parser p x a -> p -> String -> Result (Array (DeadEnd x)) a
run parser payload src =
    Parser.run parser payload src
        |> Result.mapError (Array.map (\d -> { row = d.row, col = d.col, problem = d.problem }))
