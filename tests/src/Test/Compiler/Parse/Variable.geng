module Test.Compiler.Parse.Variable exposing ( tests )

import Test.Compiler.Parse.Run as Run
import Expect exposing (Expectation)
import Test exposing (Test, describe, test)
import String.Parser.Advanced as Parser
import Compiler.Parse.Variable as PV
import Compiler.Parse.Context as Context
import Set


tests : Test
tests =
    describe "Parse.Variable"
        [ describe "Lower case"
            [ test "Simple case" <| \_ ->
                Run.run PV.lowerCase Context.empty "myvar"
                    |> Expect.equal (Ok "myvar")
            , test "unicode" <| \_ ->
                Run.run PV.lowerCase Context.empty "åberg albert"
                    |> Expect.equal (Ok "åberg")
            , test "underscore" <| \_ ->
                Run.run PV.lowerCase Context.empty "my_var"
                    |> Expect.equal (Ok "my_var")
            , test "with unicode, upper case, digits and underscore" <| \_ ->
                Run.run PV.lowerCase Context.empty "miN_1_Øse"
                    |> Expect.equal (Ok "miN_1_Øse")
            , test "no emojis" <| \_ ->
                Run.run PV.lowerCase Context.empty "hey🫵"
                    |> Expect.equal (Ok "hey")
            , test "cannot start with digit" <| \_ ->
                Run.run PV.lowerCase Context.empty "1month"
                    |> expectErr PV.InvalidCharacter
            , test "cannot start with upper case" <| \_ ->
                Run.run PV.lowerCase Context.empty "Month"
                    |> expectErr PV.InvalidCharacter
            , test "refuses to parse reserved words" <| \_ ->
                Set.toArray PV.reservedWords
                    |> Array.map (Run.run PV.lowerCase Context.empty)
                    |> Result.firstOk
                    |> Expect.equal Nothing
            ]
        , describe "Upper case"
            [ test "Simple case" <| \_ ->
                Run.run PV.upperCase Context.empty "Myvar"
                    |> Expect.equal (Ok "Myvar")
            , test "unicode" <| \_ ->
                Run.run PV.upperCase Context.empty "Åberg albert"
                    |> Expect.equal (Ok "Åberg")
            , test "underscore" <| \_ ->
                Run.run PV.upperCase Context.empty "My_var"
                    |> Expect.equal (Ok "My_var")
            , test "with unicode, upper case, digits and underscore" <| \_ ->
                Run.run PV.upperCase Context.empty "MiN_1_Øse"
                    |> Expect.equal (Ok "MiN_1_Øse")
            , test "no emojis" <| \_ ->
                Run.run PV.upperCase Context.empty "Hey🫵"
                    |> Expect.equal (Ok "Hey")
            , test "cannot start with digit" <| \_ ->
                Run.run PV.upperCase Context.empty "1month"
                    |> expectErr PV.InvalidCharacter
            , test "cannot start with lower case" <| \_ ->
                Run.run PV.upperCase Context.empty "month"
                    |> expectErr PV.InvalidCharacter
            ]
        , describe "Possibly qualified upper"
            [ test "Unqualified" <| \_ ->
                Run.run PV.foreignUpper Context.empty "Upper"
                    |> Expect.equal (Ok (PV.Unqualified "Upper"))
            , test "Qualified" <| \_ ->
                Run.run PV.foreignUpper Context.empty "My.Upper"
                    |> Expect.equal (Ok (PV.Qualified { module_ = "My", name = "Upper" }))
            , test "Qualified (2)" <| \_ ->
                Run.run PV.foreignUpper Context.empty "My.Nested.Upper"
                    |> Expect.equal (Ok (PV.Qualified { module_ = "My.Nested", name = "Upper" }))
            ]
        ]


expectErr : PV.Error -> Result (Array (Run.DeadEnd PV.Error)) String -> Expectation
expectErr expected result =
    when result is
        Ok _ ->
            Expect.fail "Expected error"

        Err problems ->
            when Array.first problems is
                Just firstProblem ->
                    Expect.equal expected firstProblem.problem

                Nothing ->
                    Expect.fail "Failed, but with no problems..."
